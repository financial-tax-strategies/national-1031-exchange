---
import AdminLayout from '../../layouts/AdminLayout.astro';
import HighLevelConfigComponent from '../../components/admin/HighLevelConfig';

// In production, add authentication check here
// const session = await getSession(Astro.request);
// if (!session || !session.user.isAdmin) {
//   return Astro.redirect('/login');
// }
---

<AdminLayout title="HighLevel Configuration - Admin">
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl font-bold mb-8">HighLevel Integration Settings</h1>
      
      <div class="mb-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
        <p class="text-sm text-blue-700">
          Configure your HighLevel CRM integration settings. These credentials will be used to sync leads and appointments.
        </p>
      </div>
      
      <HighLevelConfigComponent client:load />
    </div>
  </main>
</AdminLayout>

<style>
  main {
    min-height: calc(100vh - 200px);
  }
</style>
---
import Layout from '../layouts/Layout.astro';
import { TimelineCalculator } from '../components/calculators/TimelineCalculator';
import { COMPANY } from '../config/company';
---

<Layout 
  title="1031 Exchange Timeline Calculator | Track Critical Deadlines"
  description="Never miss a 1031 exchange deadline. Free timeline calculator tracks your 45-day identification and 180-day purchase deadlines with alerts and reminders."
>
  <div class="bg-gray-50 min-h-screen py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          1031 Exchange Timeline Calculator
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Track your critical 1031 exchange deadlines with precision. Our timeline calculator ensures 
          you never miss the 45-day identification or 180-day purchase deadlines.
        </p>
      </div>

      <!-- Warning Banner -->
      <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-8 max-w-4xl mx-auto">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-red-700">
              <strong>Critical Notice:</strong> 1031 exchange deadlines are statutory and cannot be extended 
              for any reason, including weekends, holidays, or natural disasters. Missing a deadline will 
              disqualify your entire exchange.
            </p>
          </div>
        </div>
      </div>

      <!-- Benefits Grid -->
      <div class="grid md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white p-6 rounded-lg shadow-md">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Real-Time Countdown</h3>
          <p class="text-gray-600">Live countdown showing exactly how many days remain for each deadline</p>
        </div>
        
        <div class="bg-white p-6 rounded-lg shadow-md">
          <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Smart Alerts</h3>
          <p class="text-gray-600">Set up email and calendar reminders before critical deadlines approach</p>
        </div>
        
        <div class="bg-white p-6 rounded-lg shadow-md">
          <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Property Tracker</h3>
          <p class="text-gray-600">Manage your identified properties and track which rule you're using</p>
        </div>
      </div>

      <!-- Calculator Component -->
      <TimelineCalculator client:load />

      <!-- Educational Content -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Understanding 1031 Exchange Deadlines</h2>
        
        <div class="space-y-8">
          <div class="bg-white rounded-lg shadow-md p-8">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">The 45-Day Identification Period</h3>
            <p class="text-gray-600 mb-4">
              From the day you close on the sale of your relinquished property, you have exactly 45 calendar days 
              to identify potential replacement properties. This deadline is absolute and includes weekends and holidays.
            </p>
            <div class="bg-blue-50 rounded-lg p-4">
              <h4 class="font-semibold text-blue-900 mb-2">Identification Rules:</h4>
              <ul class="space-y-2 text-blue-800">
                <li class="flex items-start">
                  <span class="font-semibold mr-2">3-Property Rule:</span>
                  <span>Identify up to 3 properties of any value (most common)</span>
                </li>
                <li class="flex items-start">
                  <span class="font-semibold mr-2">200% Rule:</span>
                  <span>Identify unlimited properties if total value doesn't exceed 200% of sale price</span>
                </li>
                <li class="flex items-start">
                  <span class="font-semibold mr-2">95% Rule:</span>
                  <span>Identify any number of properties but must purchase 95% of identified value</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow-md p-8">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">The 180-Day Exchange Period</h3>
            <p class="text-gray-600 mb-4">
              You must complete the purchase of your replacement property within 180 calendar days of selling 
              your relinquished property. This period runs concurrently with the 45-day identification period.
            </p>
            <div class="bg-yellow-50 rounded-lg p-4">
              <p class="text-yellow-800">
                <strong>Important:</strong> The 180-day period may be cut short if your tax return is due before 
                the 180 days are up. You can file for an extension to preserve the full 180 days.
              </p>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow-md p-8">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Common Timeline Mistakes to Avoid</h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-red-500 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
                <span>Thinking you have 45 business days instead of calendar days</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-red-500 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
                <span>Not accounting for holidays when calculating deadlines</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-red-500 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
                <span>Waiting until the last minute to identify properties</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-red-500 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
                <span>Not properly documenting your identification with your QI</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="mt-16 bg-blue-900 rounded-2xl p-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">
          Need Help Managing Your Exchange Timeline?
        </h2>
        <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
          Our exchange specialists can guide you through every deadline and ensure your exchange stays on track.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/schedule" 
            class="bg-yellow-400 text-blue-900 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-yellow-300 transition-all duration-300 transform hover:scale-105"
          >
            Schedule Consultation
          </a>
          <a 
            href={`tel:${COMPANY.phone.main.replace(/[^0-9]/g, '')}`}
            class="border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-blue-900 transition-all duration-300"
          >
            Call {COMPANY.phone.main}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Schema Markup -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "1031 Exchange Timeline Calculator",
    "description": "Free timeline calculator for tracking 1031 exchange deadlines including 45-day identification and 180-day purchase periods",
    "url": "https://the1031center.com/timeline-calculator",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "provider": {
      "@type": "Organization",
      "name": "National 1031 Center",
      "@id": "https://the1031center.com/#organization"
    },
    "featureList": [
      "45-day identification deadline tracking",
      "180-day purchase deadline tracking",
      "Real-time countdown timers",
      "Email and calendar reminders",
      "Property identification tracker",
      "Multiple identification rule support"
    ]
  }
  </script>
</Layout>
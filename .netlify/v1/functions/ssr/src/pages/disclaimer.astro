---
import Layout from '../layouts/Layout.astro';
import { COMPANY } from '../config/company';
---

<Layout 
  title={`Disclaimer | ${COMPANY.name}`}
  description={`Legal disclaimer for ${COMPANY.name}. Important information about our 1031 exchange services, tax advice limitations, and website use.`}
>
  
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-blue-900 via-blue-800 to-blue-900 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          Disclaimer
        </h1>
        <p class="text-xl text-blue-100">
          Important legal information about our services and website.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Legal Content Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Important Notice -->
      <div class="mb-8 p-4 bg-yellow-50 border-l-4 border-yellow-500 rounded">
        <p class="text-sm text-yellow-900">
          <strong>Important:</strong> Please read this disclaimer carefully before using our services or website.
        </p>
      </div>

      <!-- Disclaimer Content -->
      <div id="disclaimer-content" class="prose prose-lg max-w-none">
        <!-- 
          ================================================================
          DISCLAIMER CONTENT OPTIONS:
          ================================================================
          
          Option 1: If using Termageddon for disclaimer
          - Replace this section with your Termageddon embed script
          - Example: <script src="https://app.termageddon.com/embed/disclaimer/[YOUR-ID]"></script>
          
          Option 2: Custom disclaimer content
          - Replace this section with your custom disclaimer text
          - Ensure all content is reviewed by legal counsel
          
          ================================================================
        -->
        
        <!-- Default Disclaimer Content -->
        <div class="space-y-8">
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">General Information</h2>
            <p class="text-gray-700 mb-4">
              The information provided on this website and through {COMPANY.name}'s services is for general 
              informational purposes only. All information is provided in good faith, however we make no 
              representation or warranty of any kind, express or implied, regarding the accuracy, adequacy, 
              validity, reliability, availability, or completeness of any information.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Not Tax or Legal Advice</h2>
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-4">
              <p class="text-red-900 font-semibold">
                {COMPANY.name} is not a law firm or tax advisory firm.
              </p>
            </div>
            <p class="text-gray-700 mb-4">
              The information provided on this website and through our services does not, and is not intended to, 
              constitute legal or tax advice. All information, content, and materials are for general informational 
              purposes only. Readers of this website and users of our services should contact their attorney and/or 
              tax advisor to obtain advice with respect to any particular legal or tax matter.
            </p>
            <p class="text-gray-700 mb-4">
              No reader, user, or browser of this website should act or refrain from acting on the basis of 
              information on this site without first seeking legal advice from counsel in the relevant jurisdiction.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">1031 Exchange Services</h2>
            <p class="text-gray-700 mb-4">
              {COMPANY.name} serves solely as a Qualified Intermediary for 1031 exchanges. We facilitate the 
              exchange process according to IRS regulations but do not provide:
            </p>
            <ul class="list-disc pl-6 mb-4 text-gray-700">
              <li>Tax planning or tax advice</li>
              <li>Legal advice or legal services</li>
              <li>Investment advice or recommendations</li>
              <li>Property valuations or appraisals</li>
              <li>Real estate brokerage services</li>
            </ul>
            <p class="text-gray-700 mb-4">
              Each investor should consult with their own tax advisor, attorney, and other professionals to 
              determine if a 1031 exchange is appropriate for their specific situation.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">External Links Disclaimer</h2>
            <p class="text-gray-700 mb-4">
              This website may contain links to external websites that are not provided or maintained by 
              {COMPANY.name}. We do not guarantee the accuracy, relevance, timeliness, or completeness of 
              any information on these external websites.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Professional Advice Disclaimer</h2>
            <p class="text-gray-700 mb-4">
              All users of our services are advised to seek independent professional advice regarding their 
              specific tax situation, legal matters, and investment decisions. The success of a 1031 exchange 
              depends on numerous factors specific to each transaction and taxpayer.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Limitation of Liability</h2>
            <p class="text-gray-700 mb-4">
              To the fullest extent permitted by applicable law, {COMPANY.name} shall not be liable for any 
              special, incidental, indirect, or consequential damages whatsoever, including but not limited to:
            </p>
            <ul class="list-disc pl-6 mb-4 text-gray-700">
              <li>Loss of revenue or anticipated profits</li>
              <li>Loss of business or business opportunities</li>
              <li>Tax liabilities or penalties</li>
              <li>Legal costs or expenses</li>
              <li>Any other pecuniary loss</li>
            </ul>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Changes to This Disclaimer</h2>
            <p class="text-gray-700 mb-4">
              We reserve the right to make changes to this disclaimer at any time. Any changes will be posted 
              on this page with an updated revision date.
            </p>
            <p class="text-gray-700">
              <strong>Last Updated:</strong> {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
          </section>
        </div>
      </div>

      <!-- Contact Information -->
      <div class="mt-12 pt-8 border-t border-gray-200">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Questions About This Disclaimer?</h2>
        <p class="text-gray-700 mb-6">
          If you have any questions about this disclaimer, please contact us:
        </p>
        <div class="bg-gray-50 rounded-lg p-6 space-y-3">
          <p class="text-gray-700">
            <strong>Email:</strong> 
            <a href={`mailto:${COMPANY.email.main}`} class="text-blue-600 hover:text-blue-800 transition-colors">
              {COMPANY.email.main}
            </a>
          </p>
          <p class="text-gray-700">
            <strong>Phone:</strong> 
            <a href={`tel:${COMPANY.phone.main.replace(/[^0-9]/g, '')}`} class="text-blue-600 hover:text-blue-800 transition-colors">
              {COMPANY.phone.main}
            </a>
          </p>
          <p class="text-gray-700">
            <strong>Address:</strong><br>
            {COMPANY.name}<br>
            {COMPANY.address.street}<br>
            {COMPANY.address.city}, {COMPANY.address.state} {COMPANY.address.zip}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">
        Ready to Start Your 1031 Exchange?
      </h2>
      <p class="text-gray-600 mb-8">
        Consult with your tax advisor, then let our expert team guide you through the exchange process.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/start-exchange" 
          class="inline-block bg-yellow-400 text-blue-900 px-8 py-3 rounded-lg font-semibold hover:bg-yellow-300 transition-colors duration-200"
        >
          Start Your Exchange
        </a>
        <a 
          href="/schedule" 
          class="inline-block bg-blue-900 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-800 transition-colors duration-200"
        >
          Book Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Ensure proper spacing for legal content */
  #disclaimer-content h1,
  #disclaimer-content h2,
  #disclaimer-content h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  #disclaimer-content p {
    line-height: 1.7;
  }
  
  #disclaimer-content ul,
  #disclaimer-content ol {
    margin-bottom: 1rem;
  }
  
  #disclaimer-content li {
    margin-bottom: 0.5rem;
  }
</style>
        <ul class="space-y-2 text-gray-700">
          {competitor.strengths.map((strength) => (
            <li class="flex items-start">
              <svg class="w-5 h-5 text-gray-400 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              {strength}
            </li>
          ))}
        </ul>
        
        <p class="text-gray-700 mt-6">
          While {competitor.name} offers these benefits, many investors find that National 1031 Center's 
          combination of personalized service, advanced technology, and superior security provides a 
          more comprehensive solution for their exchange needs.
        </p>
      </div>
    </div>
  </section>

  <!-- Client Testimonials -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

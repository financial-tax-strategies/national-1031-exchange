      'Certified Information Security Manager (CISM)'
    ],
    experience: '20 years',
    specialties: ['Operations management', 'Technology integration', 'Security protocols', 'Process optimization'],
    awards: [
      'Excellence in Operations Award, FEA (2023)',
      'Innovation in Exchange Services (2022)'
    ],
    linkedin: 'https://linkedin.com/in/michaelchen1031',
    email: 'michael.chen@the1031center.com'
  },
  {
    id: 'jennifer-martinez',
    name: 'Jennifer Martinez',
    title: 'Senior Vice President, Exchange Services',
    image: '/images/team/jennifer-martinez.jpg',

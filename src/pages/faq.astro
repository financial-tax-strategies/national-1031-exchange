        "acceptedAnswer": {
          "@type": "Answer",
          "text": "There are two critical deadlines: the 45-day identification period (you must identify potential replacement properties within 45 calendar days of selling) and the 180-day exchange period (you must close on your replacement property within 180 calendar days of selling)."
        }

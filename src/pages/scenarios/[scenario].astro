const { scenario } = Astro.props;

// Helper function to get related scenarios
function getRelatedScenarios(currentScenario, allScenarios) {
  return allScenarios
    .filter(s => s.category === currentScenario.category && s.slug !== currentScenario.slug)
    .slice(0, 3);
}

const allScenarios = [
  { slug: 'exchange-multiple-properties', title: 'Exchange Multiple Properties', category: 'Portfolio Strategy' },
  { slug: 'exchange-to-downsize', title: 'Downsize Through Exchange', category: 'Portfolio Strategy' },
  { slug: 'exchange-into-different-state', title: 'Exchange Into Different State', category: 'Geographic Strategy' },
  { slug: 'exchange-with-mortgage', title: 'Exchange with Mortgage', category: 'Financing' }
];

const relatedScenarios = getRelatedScenarios(scenario, allScenarios);
---

<Layout 
  title={`${scenario.title} | 1031 Exchange Guide`}
  description={`Learn ${scenario.title.toLowerCase()}. Expert guidance on ${scenario.description.toLowerCase()}.`}
>
  
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-blue-50 to-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="flex items-center justify-center gap-2 text-sm text-gray-600 mb-4">
          <a href="/" class="hover:text-blue-600">Home</a>
          <span>/</span>
          <a href="/scenarios" class="hover:text-blue-600">Exchange Scenarios</a>
          <span>/</span>
          <span class="text-gray-900">{scenario.shortTitle}</span>
        </div>
        
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          {scenario.title}
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
          {scenario.description}. Get expert guidance on navigating this specific 1031 exchange scenario 
          to maximize your tax benefits and achieve your investment goals.
        </p>
        
        <!-- Quick Info Cards -->
        <div class="grid md:grid-cols-3 gap-4 max-w-3xl mx-auto mb-8">
          <div class="bg-white rounded-lg shadow-md p-4">
            <div class="text-sm text-gray-600">Difficulty Level</div>
            <div class={`font-semibold ${
              scenario.difficulty === 'Complex' ? 'text-red-600' :
              scenario.difficulty === 'Advanced' ? 'text-orange-600' :
              'text-green-600'
            }`}>{scenario.difficulty}</div>
          </div>
          <div class="bg-white rounded-lg shadow-md p-4">
            <div class="text-sm text-gray-600">Typical Timeframe</div>
            <div class="font-semibold text-gray-900">{scenario.timeframe}</div>
          </div>
          <div class="bg-white rounded-lg shadow-md p-4">
            <div class="text-sm text-gray-600">Category</div>
            <div class="font-semibold text-gray-900">{scenario.category}</div>
          </div>
        </div>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" 
             class="bg-yellow-400 text-blue-900 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-yellow-300 transition-all duration-300 transform hover:scale-105 shadow-lg">
            Get Expert Help
          </a>
          <a href="/calculator" 
             class="border-2 border-blue-600 text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-600 hover:text-white transition-all duration-300">
            Calculate Your Savings
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Overview Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-8">Understanding This Exchange Scenario</h2>
      
      <div class="prose prose-lg max-w-none text-gray-600 mb-8">
        <p class="mb-6">
          {scenario.description} requires careful planning and expert guidance to navigate successfully. 
          This type of exchange presents unique opportunities and challenges that investors must understand 
          to maximize their tax benefits while achieving their investment objectives.
        </p>
        
        <div class="bg-blue-50 border-l-4 border-blue-400 p-6 rounded-lg mb-8">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Why This Matters</h3>
          <p class="text-gray-700">
            Whether you're looking to optimize your portfolio, adapt to changing life circumstances, or 
            take advantage of market opportunities, understanding how to properly structure this type of 
            exchange is crucial for preserving your tax deferral and maximizing your investment returns.
          </p>
        </div>
      </div>
      
      <!-- Key Benefits and Challenges -->
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-green-50 rounded-lg p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
            <svg class="w-6 h-6 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Key Benefits
          </h3>
          <ul class="space-y-3">
            {scenario.keyBenefits.map((benefit) => (
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">{benefit}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="bg-orange-50 rounded-lg p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">

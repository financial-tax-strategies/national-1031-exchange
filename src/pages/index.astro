---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout title="America's Most Trusted 1031 Exchange Partner | National 1031 Center">
  <Navigation />
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-blue-900 via-blue-800 to-blue-900 text-white overflow-hidden">
    <div class="absolute inset-0 bg-black opacity-20"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="text-center">
        <!-- Trust Badge -->
        <div class="inline-flex items-center bg-blue-800 bg-opacity-50 px-4 py-2 rounded-full text-sm font-medium mb-6">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          Trusted by 10,000+ Investors Nationwide
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          Defer Capital Gains Taxes with 
          <span class="text-yellow-400">America's Most Trusted</span>
          1031 Exchange Partner
        </h1>
        
        <p class="text-xl lg:text-2xl mb-8 max-w-4xl mx-auto leading-relaxed text-blue-100">
          Save hundreds of thousands in taxes with our expert 1031 exchange services. 
          Industry-leading security, nationwide coverage, and 48-hour response guarantee.
        </p>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a href="/contact" class="bg-yellow-400 text-blue-900 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-yellow-300 transition-all duration-300 transform hover:scale-105 shadow-lg">
            Start Your Exchange Today
          </a>
          <a href="/calculator" class="border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-blue-900 transition-all duration-300">
            Calculate Your Savings
          </a>
        </div>
        
        <!-- Trust Indicators -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-16">
          <div class="text-center">
            <div class="text-3xl font-bold text-yellow-400">$100M</div>
            <div class="text-sm text-blue-200">Fidelity Bond</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-yellow-400">50</div>
            <div class="text-sm text-blue-200">States Served</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-yellow-400">24/7</div>
            <div class="text-sm text-blue-200">Support</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-yellow-400">A+</div>
            <div class="text-sm text-blue-200">BBB Rating</div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Services Overview -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">
          Complete 1031 Exchange Services
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          From simple delayed exchanges to complex reverse and improvement structures, 
          we handle every type of tax-deferred exchange with unmatched expertise.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Delayed Exchange -->
        <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-4">Delayed Exchange</h3>
          <p class="text-gray-600 mb-6">
            Standard forward exchanges. Sell first, then buy replacement property within 180 days.
          </p>
          <a href="/services/delayed-exchange" class="text-blue-600 font-semibold hover:text-blue-700 transition-colors">
            Learn More →
          </a>
        </div>
        
        <!-- Reverse Exchange -->
        <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="w-16 h-16 bg-green-100 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-4">Reverse Exchange</h3>
          <p class="text-gray-600 mb-6">
            Buy first, sell later. Perfect for competitive markets where timing is critical.
          </p>
          <a href="/services/reverse-exchange" class="text-blue-600 font-semibold hover:text-blue-700 transition-colors">
            Learn More →
          </a>
        </div>
        
        <!-- Improvement Exchange -->
        <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="w-16 h-16 bg-purple-100 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-4">Improvement Exchange</h3>
          <p class="text-gray-600 mb-6">
            Build-to-suit exchanges. Use exchange funds to improve replacement property.
          </p>
          <a href="/services/improvement-exchange" class="text-blue-600 font-semibold hover:text-blue-700 transition-colors">
            Learn More →
          </a>
        </div>
        
        <!-- Partial Exchange -->
        <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="w-16 h-16 bg-orange-100 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0SK00 002 2h2a2 2 0 002-2Z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 19V5a2 2 0 00-2-2H11a2 2 0 00-2 2v14a2 2 0 002 2h8a2 2 0 002-2Z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-4">Partial Exchange</h3>
          <p class="text-gray-600 mb-6">
            Strategic cash-out while still deferring taxes on the majority of proceeds.
          </p>
          <a href="/services/partial-exchange" class="text-blue-600 font-semibold hover:text-blue-700 transition-colors">
            Learn More →
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Why Choose Us -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">
          Why 10,000+ Investors Trust National 1031 Center
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          When hundreds of thousands in taxes are at stake, you need a qualified intermediary 
          you can trust completely. Here's why we're America's preferred choice.
        </p>
      </div>
      
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Security First -->
        <div class="text-center">
          <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.031 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Unmatched Security</h3>
          <ul class="text-gray-600 space-y-2">
            <li>$100 million fidelity bond</li>
            <li>Segregated client accounts</li>
            <li>Daily reconciliation</li>
            <li>Parent company guarantee</li>
            <li>FDIC insured deposits</li>
          </ul>
        </div>
        
        <!-- Expert Team -->
        <div class="text-center">
          <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Expert Team</h3>
          <ul class="text-gray-600 space-y-2">
            <li>Certified Exchange Specialists</li>
            <li>Attorneys and CPAs on staff</li>
            <li>30+ years combined experience</li>
            <li>All exchange types mastered</li>
            <li>Continuous education</li>
          </ul>
        </div>
        
        <!-- Service Excellence -->
        <div class="text-center">
          <div class="w-20 h-20 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Service Excellence</h3>
          <ul class="text-gray-600 space-y-2">
            <li>48-hour response guarantee</li>
            <li>Dedicated exchange coordinator</li>
            <li>24/7 emergency support</li>
            <li>Online portal access</li>
            <li>White-glove service</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA Section -->
  <section class="py-20 bg-blue-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold mb-6">
        Ready to Save on Capital Gains Taxes?
      </h2>
      <p class="text-xl mb-8 text-blue-200">
        Don't pay unnecessary taxes. Start your 1031 exchange with America's most trusted QI today.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="bg-yellow-400 text-blue-900 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-yellow-300 transition-all duration-300 transform hover:scale-105">
          Get Free Consultation
        </a>
        <a href="/calculator" class="border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-blue-900 transition-all duration-300">
          Calculate Savings
        </a>
      </div>
      
      <div class="mt-12 text-center">
        <p class="text-blue-300 text-sm">
          Call now: <a href="tel:+18001031TAX" class="text-yellow-400 hover:text-yellow-300 font-semibold">1-800-1031-TAX</a> | 
          Available 24/7 for emergencies
        </p>
      </div>
    </div>
  </section>
  
  <!-- Footer placeholder -->
  <footer class="bg-gray-900 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="text-gray-400">
          © 2024 National 1031 Center. All rights reserved. | 
          <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a> | 
          <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
        </p>
      </div>
    </div>
  </footer>
</Layout>

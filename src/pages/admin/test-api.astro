---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="API Test">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">API Endpoint Test</h1>
    
    <div class="space-y-8">
      <!-- Test Methods Endpoint -->
      <div class="bg-white p-6 rounded-lg shadow">
        <h2 class="text-xl font-semibold mb-4">Test /api/test-methods</h2>
        <div class="space-x-2">
          <button onclick="testMethod('test-methods', 'GET')" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
            Test GET
          </button>
          <button onclick="testMethod('test-methods', 'POST')" class="px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600">
            Test POST
          </button>
          <button onclick="testMethod('test-methods', 'PATCH')" class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600">
            Test PATCH
          </button>
          <button onclick="testMethod('test-methods', 'PUT')" class="px-4 py-2 bg-purple-500 text-white rounded hover:bg-purple-600">
            Test PUT
          </button>
          <button onclick="testMethod('test-methods', 'DELETE')" class="px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600">
            Test DELETE
          </button>
        </div>
        <pre id="test-methods-result" class="mt-4 p-4 bg-gray-100 rounded overflow-x-auto"></pre>
      </div>
      
      <!-- Team Members Endpoint -->
      <div class="bg-white p-6 rounded-lg shadow">
        <h2 class="text-xl font-semibold mb-4">Test /api/team-members</h2>
        <div class="space-x-2">
          <button onclick="testMethod('team-members', 'GET')" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
            Test GET
          </button>
          <button onclick="testMethod('team-members', 'POST')" class="px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600">
            Test POST
          </button>
          <button onclick="testMethod('team-members', 'PATCH')" class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600">
            Test PATCH
          </button>
        </div>
        <pre id="team-members-result" class="mt-4 p-4 bg-gray-100 rounded overflow-x-auto"></pre>
      </div>
      
      <!-- Direct CURL Commands -->
      <div class="bg-white p-6 rounded-lg shadow">
        <h2 class="text-xl font-semibold mb-4">CURL Commands to Test</h2>
        <div class="space-y-2">
          <p class="font-mono text-sm bg-gray-100 p-2 rounded">
            curl -X PATCH https://the1031center.com/api/team-members -H "Content-Type: application/json" -d '{"id":"test"}'
          </p>
          <p class="font-mono text-sm bg-gray-100 p-2 rounded">
            curl -X PATCH https://the1031center.com/api/test-methods
          </p>
        </div>
      </div>
    </div>
  </main>
</AdminLayout>

<script>
  async function testMethod(endpoint, method) {
    const resultEl = document.getElementById(`${endpoint}-result`);
    resultEl.textContent = `Testing ${method} /api/${endpoint}...`;
    
    try {
      const options = {
        method: method,
        headers: {
          'Content-Type': 'application/json',
        }
      };
      
      // Add body for POST/PATCH
      if (['POST', 'PATCH', 'PUT'].includes(method)) {
        options.body = JSON.stringify({ 
          id: 'test-id',
          name: 'Test Name',
          test: true 
        });
      }
      
      const response = await fetch(`/api/${endpoint}`, options);
      const text = await response.text();
      
      let data;
      try {
        data = JSON.parse(text);
      } catch {
        data = text;
      }
      
      resultEl.textContent = JSON.stringify({
        status: response.status,
        statusText: response.statusText,
        headers: Object.fromEntries(response.headers.entries()),
        data: data
      }, null, 2);
    } catch (error) {
      resultEl.textContent = JSON.stringify({
        error: error.message,
        stack: error.stack
      }, null, 2);
    }
  }
</script>
---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase, isSupabaseConfigured } from '../../lib/supabase';

// In production, add authentication check here
// const session = await getSession(Astro.request);
// if (!session || !session.user.isAdmin) {
//   return Astro.redirect('/login');
// }

let reviews = [];
let summary = null;
let error = null;

// Get filter from query params
const url = new URL(Astro.request.url);
const statusFilter = url.searchParams.get('status') || 'all';

if (isSupabaseConfigured()) {
  try {
    // Build query
    let query = supabase
      .from('reviews')
      .select('*')
      .order('created_at', { ascending: false });
    
    // Apply status filter
    if (statusFilter !== 'all') {
      query = query.eq('status', statusFilter);
    }
    
    const { data, error: fetchError } = await query;
    
    if (fetchError) {
      error = fetchError.message;
    } else {
      reviews = data || [];
    }
    
    // Get summary
    const { data: summaryData } = await supabase
      .from('reviews_summary')
      .select('*')
      .single();
    
    summary = summaryData;
  } catch (e) {
    error = 'Failed to fetch reviews';
    console.error(e);
  }
}

// Count reviews by status
const statusCounts = {
  all: reviews.length,
  pending: reviews.filter(r => r.status === 'pending').length,
  approved: reviews.filter(r => r.status === 'approved').length,
  rejected: reviews.filter(r => r.status === 'rejected').length,
  flagged: reviews.filter(r => r.status === 'flagged').length
};
---

<AdminLayout title="Reviews Management">
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-7xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-bold mb-4">Customer Reviews</h1>
        
        {summary && (
          <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
            <div class="bg-white p-4 rounded-lg shadow">
              <div class="text-2xl font-bold text-blue-600">{summary.total_reviews}</div>
              <div class="text-sm text-gray-600">Total Reviews</div>
            </div>
            <div class="bg-white p-4 rounded-lg shadow">
              <div class="text-2xl font-bold text-yellow-600">
                {summary.average_rating ? summary.average_rating.toFixed(1) : '0.0'}
              </div>
              <div class="text-sm text-gray-600">Average Rating</div>
            </div>
            <div class="bg-white p-4 rounded-lg shadow">
              <div class="text-2xl font-bold text-green-600">{summary.five_star_count}</div>
              <div class="text-sm text-gray-600">5-Star Reviews</div>
            </div>
            <div class="bg-white p-4 rounded-lg shadow">
              <div class="text-2xl font-bold text-orange-600">{statusCounts.pending}</div>
              <div class="text-sm text-gray-600">Pending Moderation</div>
            </div>
            <div class="bg-white p-4 rounded-lg shadow">
              <div class="text-2xl font-bold text-red-600">{statusCounts.flagged}</div>
              <div class="text-sm text-gray-600">Flagged</div>
            </div>
          </div>
        )}
        
        <!-- Status Filter Tabs -->
        <div class="border-b border-gray-200">
          <nav class="-mb-px flex space-x-8">
            {Object.entries(statusCounts).map(([status, count]) => (
              <a
                href={`?status=${status}`}
                class={`py-2 px-1 border-b-2 font-medium text-sm ${
                  statusFilter === status
                    ? 'border-blue-500 text-blue-600'
                    : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'
                }`}
              >
                {status.charAt(0).toUpperCase() + status.slice(1)} ({count})
              </a>
            ))}
          </nav>
        </div>
      </div>
      
      {!isSupabaseConfigured() ? (
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
          <p class="text-yellow-800">Database configuration is missing. Review management is disabled.</p>
        </div>
      ) : error ? (
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <p class="text-red-800">Error: {error}</p>
        </div>
      ) : (
        <div class="space-y-4">
          {reviews.map((review) => (
            <div class="bg-white shadow rounded-lg p-6">
              <div class="flex justify-between items-start mb-4">
                <div>
                  <div class="flex items-center mb-2">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`h-5 w-5 ${i < review.review_rating_value ? 'fill-current' : 'fill-gray-300'}`}
                          viewBox="0 0 20 20"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="ml-2 text-sm text-gray-600">
                      {review.review_rating_value}/5
                    </span>
                    {review.is_featured && (
                      <span class="ml-2 px-2 py-1 text-xs bg-yellow-100 text-yellow-800 rounded-full">
                        Featured
                      </span>
                    )}
                  </div>
                  {review.headline && (
                    <h3 class="text-lg font-semibold text-gray-900">{review.headline}</h3>
                  )}
                </div>
                <div class="flex items-center space-x-2">
                  <span class={`px-3 py-1 text-xs font-semibold rounded-full ${
                    review.status === 'approved' ? 'bg-green-100 text-green-800' :
                    review.status === 'pending' ? 'bg-yellow-100 text-yellow-800' :
                    review.status === 'rejected' ? 'bg-red-100 text-red-800' :
                    'bg-orange-100 text-orange-800'
                  }`}>
                    {review.status.charAt(0).toUpperCase() + review.status.slice(1)}
                  </span>
                </div>
              </div>
              
              <div class="text-gray-700 mb-4">
                {review.review_body || <em class="text-gray-500">No review text provided</em>}
              </div>
              
              <div class="flex flex-wrap gap-4 text-sm text-gray-600 mb-4">
                <div>
                  <strong>Author:</strong> {review.author_name}
                  {review.author_location && ` from ${review.author_location}`}
                </div>
                {review.service_type && (
                  <div>
                    <strong>Service:</strong> {review.service_type.replace(/_/g, ' ')}
                  </div>
                )}
                {review.transaction_value_range && (
                  <div>
                    <strong>Value:</strong> {review.transaction_value_range.replace(/_/g, '-')}
                  </div>
                )}
                <div>
                  <strong>Date:</strong> {new Date(review.date_published).toLocaleDateString()}
                </div>
                <div>
                  <strong>Source:</strong> {review.source}
                </div>
              </div>
              
              {review.response_text && (
                <div class="bg-gray-50 p-4 rounded mb-4">
                  <div class="text-sm font-semibold text-gray-700 mb-1">Business Response:</div>
                  <div class="text-sm text-gray-600">{review.response_text}</div>
                  {review.response_date && (
                    <div class="text-xs text-gray-500 mt-1">
                      Responded on {new Date(review.response_date).toLocaleDateString()}
                    </div>
                  )}
                </div>
              )}
              
              <div class="flex justify-between items-center pt-4 border-t">
                <div class="flex space-x-2">
                  {review.status === 'pending' && (
                    <>
                      <button 
                        class="px-3 py-1 text-sm bg-green-600 text-white rounded hover:bg-green-700 approve-btn"
                        data-id={review.id}
                      >
                        Approve
                      </button>
                      <button 
                        class="px-3 py-1 text-sm bg-red-600 text-white rounded hover:bg-red-700 reject-btn"
                        data-id={review.id}
                      >
                        Reject
                      </button>
                    </>
                  )}
                  {review.status === 'approved' && (
                    <button 
                      class="px-3 py-1 text-sm bg-yellow-600 text-white rounded hover:bg-yellow-700 feature-btn"
                      data-id={review.id}
                      data-featured={review.is_featured}
                    >
                      {review.is_featured ? 'Unfeature' : 'Feature'}
                    </button>
                  )}
                  {!review.response_text && (
                    <button 
                      class="px-3 py-1 text-sm bg-blue-600 text-white rounded hover:bg-blue-700 respond-btn"
                      data-id={review.id}
                    >
                      Respond
                    </button>
                  )}
                  {review.status !== 'flagged' && (
                    <button 
                      class="px-3 py-1 text-sm bg-orange-600 text-white rounded hover:bg-orange-700 flag-btn"
                      data-id={review.id}
                    >
                      Flag
                    </button>
                  )}
                </div>
                <div class="text-xs text-gray-500">
                  Submitted {new Date(review.created_at).toLocaleString()}
                </div>
              </div>
            </div>
          ))}
          
          {reviews.length === 0 && (
            <div class="text-center py-8 text-gray-500">
              No reviews found for the selected filter.
            </div>
          )}
        </div>
      )}
    </div>
  </main>
  
  <!-- Response Modal -->
  <div id="responseModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-full max-w-lg shadow-lg rounded-md bg-white">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Add Business Response</h3>
      
      <form id="responseForm">
        <input type="hidden" id="reviewId" />
        <textarea 
          id="responseText"
          rows="4"
          required
          placeholder="Thank you for your review..."
          class="w-full p-3 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500"
        ></textarea>
        
        <div class="flex justify-end space-x-4 mt-4">
          <button 
            type="button" 
            id="cancelResponseBtn"
            class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md"
          >
            Cancel
          </button>
          <button 
            type="submit"
            class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md"
          >
            Post Response
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  // Update review status
  async function updateReviewStatus(id: string, status: string) {
    try {
      const updates: any = { id, status };
      if (status === 'approved') {
        updates.approved_at = new Date().toISOString();
      }
      
      const response = await fetch('/api/reviews', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(updates)
      });
      
      if (response.ok) {
        window.location.reload();
      } else {
        alert('Error: Failed to update review status');
      }
    } catch (error) {
      alert('Error: Failed to update review status');
      console.error(error);
    }
  }
  
  // Approve buttons
  document.querySelectorAll('.approve-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const id = (e.target as HTMLElement).dataset.id!;
      if (confirm('Approve this review?')) {
        updateReviewStatus(id, 'approved');
      }
    });
  });
  
  // Reject buttons
  document.querySelectorAll('.reject-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const id = (e.target as HTMLElement).dataset.id!;
      if (confirm('Reject this review?')) {
        updateReviewStatus(id, 'rejected');
      }
    });
  });
  
  // Flag buttons
  document.querySelectorAll('.flag-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const id = (e.target as HTMLElement).dataset.id!;
      if (confirm('Flag this review for further review?')) {
        updateReviewStatus(id, 'flagged');
      }
    });
  });
  
  // Feature toggle
  document.querySelectorAll('.feature-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const id = target.dataset.id!;
      const isFeatured = target.dataset.featured === 'true';
      
      try {
        const response = await fetch('/api/reviews', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, is_featured: !isFeatured })
        });
        
        if (response.ok) {
          window.location.reload();
        } else {
          alert('Error: Failed to update featured status');
        }
      } catch (error) {
        alert('Error: Failed to update featured status');
        console.error(error);
      }
    });
  });
  
  // Response handling
  const responseModal = document.getElementById('responseModal');
  const responseForm = document.getElementById('responseForm') as HTMLFormElement;
  const reviewIdInput = document.getElementById('reviewId') as HTMLInputElement;
  const responseTextarea = document.getElementById('responseText') as HTMLTextAreaElement;
  const cancelResponseBtn = document.getElementById('cancelResponseBtn');
  
  document.querySelectorAll('.respond-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const id = (e.target as HTMLElement).dataset.id!;
      reviewIdInput.value = id;
      responseTextarea.value = '';
      responseModal?.classList.remove('hidden');
    });
  });
  
  cancelResponseBtn?.addEventListener('click', () => {
    responseModal?.classList.add('hidden');
  });
  
  responseForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const id = reviewIdInput.value;
    const response_text = responseTextarea.value;
    const response_date = new Date().toISOString().split('T')[0];
    
    try {
      const response = await fetch('/api/reviews', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, response_text, response_date })
      });
      
      if (response.ok) {
        window.location.reload();
      } else {
        alert('Error: Failed to post response');
      }
    } catch (error) {
      alert('Error: Failed to post response');
      console.error(error);
    }
  });
</script>
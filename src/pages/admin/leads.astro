---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase, isSupabaseConfigured } from '../../lib/supabase';
import { SearchFilter } from '../../components/common/SearchFilter';
import { StatusBadge } from '../../components/common/StatusBadge';
import { LeadScoreDisplay } from '../../components/admin/LeadScoreDisplay';
import { LeadScoreBreakdown } from '../../components/admin/LeadScoreBreakdown';

// TODO: Add authentication check in production
// const session = await getSession(Astro.request);
// if (!session || !session.user.isAdmin) {
//   return Astro.redirect('/admin/login');
// }

// Fetch leads from database only if Supabase is configured
let leads = null;
let error = null;

if (isSupabaseConfigured() && supabase) {
  const result = await supabase
    .from('leads')
    .select('*')
    .order('created_at', { ascending: false })
    .limit(100);
  
  leads = result.data;
  error = result.error;
  
  if (error) {
    console.error('Error fetching leads:', error);
  }
}

// Format leads for display (use empty array if no leads)
const formattedLeads = (leads || []).map(lead => ({
  ...lead,
  displayScore: lead.score || 0,
  displayStatus: lead.status || 'new',
  displayDate: new Date(lead.created_at).toLocaleDateString(),
  displayTime: new Date(lead.created_at).toLocaleTimeString()
})) || [];
---

<AdminLayout title="Leads Management">
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="flex justify-between items-center mb-8">
        <div>
          <h1 class="text-3xl font-bold">Leads Management</h1>
          <p class="text-gray-600 mt-2">View and manage all captured leads with automated scoring</p>
        </div>
        <div class="flex gap-4">
          <button class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
            Export Leads
          </button>
        </div>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-600">Total Leads</p>
              <p class="text-2xl font-bold">{leads?.length || 0}</p>
            </div>
            <div class="text-3xl">👥</div>
          </div>
        </div>
        
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-600">Hot Leads (80+)</p>
              <p class="text-2xl font-bold">{leads?.filter(l => l.score >= 80).length || 0}</p>
            </div>
            <div class="text-3xl">🔥</div>
          </div>
        </div>
        
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-600">Avg Score</p>
              <p class="text-2xl font-bold">
                {leads?.length > 0 
                  ? Math.round(leads.reduce((sum, l) => sum + (l.score || 0), 0) / leads.length)
                  : 0}
              </p>
            </div>
            <div class="text-3xl">📊</div>
          </div>
        </div>
        
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-600">Today's Leads</p>
              <p class="text-2xl font-bold">
                {leads?.filter(l => {
                  const today = new Date().toDateString();
                  return new Date(l.created_at).toDateString() === today;
                }).length || 0}
              </p>
            </div>
            <div class="text-3xl">📅</div>
          </div>
        </div>
      </div>

      <!-- Search and Filters -->
      <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200 mb-6">
        <SearchFilter
          placeholder="Search by name, email, or phone..."
          filters={[
            {
              label: 'Score Range',
              options: [
                { value: 'all', label: 'All Scores' },
                { value: 'hot', label: 'Hot (80+)' },
                { value: 'warm', label: 'Warm (50-79)' },
                { value: 'cold', label: 'Cold (<50)' }
              ]
            },
            {
              label: 'Status',
              options: [
                { value: 'all', label: 'All Status' },
                { value: 'new', label: 'New' },
                { value: 'contacted', label: 'Contacted' },
                { value: 'qualified', label: 'Qualified' },
                { value: 'converted', label: 'Converted' }
              ]
            }
          ]}
          onSearch={(query) => console.log('Search:', query)}
          onFilterChange={(filters) => console.log('Filters:', filters)}
          client:load
        />
      </div>

      <!-- Leads Table -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        {isSupabaseConfigured() && (
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Phone</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Score</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {formattedLeads.map((lead) => (
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  {lead.name || 'N/A'}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  {lead.email || 'N/A'}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  {lead.phone || 'N/A'}
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <LeadScoreDisplay score={lead.displayScore} client:load />
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <StatusBadge status={lead.displayStatus} client:load />
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  {lead.displayDate}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <div class="flex gap-2">
                    <a href={`/admin/leads/${lead.id}`} class="text-blue-600 hover:text-blue-800">
                      View
                    </a>
                    <button class="text-gray-600 hover:text-gray-800">
                      Contact
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        )}
        
        {!isSupabaseConfigured() && (
          <div class="text-center py-8">
            <p class="text-gray-500">Database connection not configured. Please set up Supabase environment variables.</p>
          </div>
        )}
        
        {isSupabaseConfigured() && formattedLeads.length === 0 && (
          <div class="text-center py-8">
            <p class="text-gray-500">No leads found</p>
          </div>
        )}
      </div>

      {/* Info Box */}
      <div class="mt-8 p-6 bg-blue-50 border border-blue-200 rounded-lg">
        <h2 class="text-lg font-semibold text-blue-900 mb-2">Lead Scoring System Active</h2>
        <p class="text-blue-800 mb-4">
          Leads are automatically scored based on their interactions:
        </p>
        <LeadScoreBreakdown 
          breakdown={{
            totalScore: 78,
            components: [
              { category: 'Calculator Completion', description: 'Completed tax savings calculator', points: 20 },
              { category: 'Appointment Booking', description: 'Scheduled consultation', points: 30 },
              { category: 'Document Upload', description: 'Uploaded property documents', points: 10 },
              { category: 'Form Submission', description: 'Submitted contact form', points: 15 },
              { category: 'Email Engagement', description: 'Opened marketing emails', points: 2 },
              { category: 'Website Activity', description: 'Visited multiple pages', points: 1 }
            ],
            scorePercentage: 78,
            scoreGrade: 'B',
            recommendation: 'High-quality lead ready for immediate follow-up'
          }}
          showRecommendation={true}
          client:load
        />
      </div>
    </div>
  </main>
</AdminLayout>

<style>
  main {
    min-height: calc(100vh - 200px);
  }
</style>
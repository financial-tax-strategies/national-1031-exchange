---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase, supabaseAdmin, isSupabaseConfigured, isSupabaseAdminConfigured } from '../../lib/supabase';
import { AuthService } from '../../lib/services/auth.service';

// Authentication check for admin access
let isAuthenticated = false;
let authError = null;

// Development bypass: Allow access if NODE_ENV is development
const isDevelopment = import.meta.env.NODE_ENV === 'development' || import.meta.env.DEV;

if (isDevelopment) {
  console.log('[Admin] Development mode - bypassing authentication');
  isAuthenticated = true;
} else {
  try {
    const authService = AuthService.getInstance();
    const userResponse = await authService.getCurrentUser();
    
    if (userResponse.success && userResponse.data && userResponse.data.adminProfile) {
      isAuthenticated = true;
    } else {
      // Redirect to admin login if not authenticated
      return Astro.redirect('/admin/login');
    }
  } catch (e) {
    console.error('Authentication error:', e);
    authError = 'Authentication failed';
    return Astro.redirect('/admin/login');
  }
}

let teamMembers = [];
let error = null;

if (isSupabaseAdminConfigured() && isAuthenticated) {
  try {
    // Use admin client with service role key - completely bypasses RLS policies
    // This allows admins to see ALL team members, including inactive ones
    const { data, error: fetchError } = await supabaseAdmin
      .from('team_members')
      .select('*')
      .order('display_order', { ascending: true })
      .order('name', { ascending: true });
    
    if (fetchError) {
      error = fetchError.message;
      console.error('Database error:', fetchError);
    } else {
      teamMembers = data || [];
      console.log(`[Admin] Loaded ${teamMembers.length} team members (including inactive) via admin client`);
    }
  } catch (e) {
    error = 'Failed to fetch team members';
    console.error('Fetch error:', e);
  }
} else if (!isSupabaseAdminConfigured()) {
  error = 'Admin database configuration missing (SUPABASE_SERVICE_ROLE_KEY required)';
} else if (!isSupabaseConfigured()) {
  error = 'Database not configured';
}
---

<AdminLayout title="Team Members Management">
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Team Members</h1>
        <button 
          id="addMemberBtn"
          class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors"
        >
          Add Team Member
        </button>
      </div>
      
      {!isSupabaseAdminConfigured() ? (
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
          <p class="text-yellow-800">Admin database configuration is missing (SUPABASE_SERVICE_ROLE_KEY required). Team member management is disabled.</p>
        </div>
      ) : error ? (
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <p class="text-red-800">Error: {error}</p>
        </div>
      ) : (
        <div class="bg-white shadow-md rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Order
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Name
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Title
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Email
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Status
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              {teamMembers.map((member) => (
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    {member.display_order}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                      {member.image && (
                        <img 
                          src={member.image} 
                          alt={member.name} 
                          class="h-10 w-10 rounded-full mr-3"
                        />
                      )}
                      <div>
                        <div class="text-sm font-medium text-gray-900">
                          {member.name}
                        </div>
                        <div class="text-sm text-gray-500">
                          /{member.slug}
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    {member.job_title || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    {member.email || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${
                      member.is_active 
                        ? 'bg-green-100 text-green-800' 
                        : 'bg-red-100 text-red-800'
                    }`}>
                      {member.is_active ? 'Active' : 'Inactive'}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <button 
                      class="text-indigo-600 hover:text-indigo-900 mr-3 edit-btn"
                      data-member={JSON.stringify(member)}
                    >
                      Edit
                    </button>
                    <button 
                      class="text-red-600 hover:text-red-900 toggle-btn"
                      data-id={member.id}
                      data-active={member.is_active}
                    >
                      {member.is_active ? 'Deactivate' : 'Activate'}
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          
          {teamMembers.length === 0 && (
            <div class="text-center py-8 text-gray-500">
              No team members found. Click "Add Team Member" to create one.
            </div>
          )}
        </div>
      )}
    </div>
  </main>
  
  <!-- Add/Edit Modal -->
  <div id="memberModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
    <div class="relative top-10 mx-auto p-5 border w-full max-w-4xl shadow-lg rounded-lg bg-white">
      <div class="flex justify-between items-center mb-6">
        <h3 id="modalTitle" class="text-2xl font-bold text-gray-900">Add Team Member</h3>
        <button type="button" id="closeModalBtn" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <!-- Tab Navigation -->
      <div class="border-b border-gray-200 mb-6">
        <nav class="-mb-px flex space-x-8">
          <button type="button" class="tab-btn active py-2 px-1 border-b-2 border-blue-500 font-medium text-sm text-blue-600" data-tab="basic">
            Basic Info
          </button>
          <button type="button" class="tab-btn py-2 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300" data-tab="contact">
            Contact & Location
          </button>
          <button type="button" class="tab-btn py-2 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300" data-tab="professional">
            Professional
          </button>
          <button type="button" class="tab-btn py-2 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300" data-tab="social">
            Social Media
          </button>
          <button type="button" class="tab-btn py-2 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300" data-tab="additional">
            Additional
          </button>
        </nav>
      </div>
      
      <form id="memberForm" class="space-y-6">
        <input type="hidden" id="memberId" name="id" />
        
        <!-- Tab Panels -->
        <div class="tab-panels">
          <!-- Basic Info Tab -->
          <div id="basic-tab" class="tab-panel active">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Name *</label>
                <input 
                  type="text" 
                  name="name" 
                  required 
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700">URL Slug</label>
                <input 
                  type="text" 
                  name="slug" 
                  id="slugInput"
                  placeholder="auto-generated from name"
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
                <p class="text-xs text-gray-500 mt-1">Leave empty to auto-generate from name</p>
              </div>
            </div>
            
            <div class="grid grid-cols-2 gap-4 mt-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Job Title</label>
                <input 
                  type="text" 
                  name="job_title" 
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700">Organization</label>
                <input 
                  type="text" 
                  name="works_for" 
                  value="The 1031 Center"
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
            </div>
            
            <div class="grid grid-cols-2 gap-4 mt-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Honorific Prefix</label>
                <input 
                  type="text" 
                  name="honorific_prefix" 
                  placeholder="Dr., Prof., etc."
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700">Honorific Suffix</label>
                <input 
                  type="text" 
                  name="honorific_suffix" 
                  placeholder="PhD, MD, CPA, etc."
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
            </div>
            
            <div class="mt-4">
              <label class="block text-sm font-medium text-gray-700">Profile Image URL</label>
              <input 
                type="url" 
                name="image" 
                placeholder="/images/team/name.jpg"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              />
            </div>
            
            <div class="grid grid-cols-2 gap-4 mt-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Display Order</label>
                <input 
                  type="number" 
                  name="display_order" 
                  value="0"
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
              
              <div class="flex items-center mt-6">
                <input 
                  type="checkbox" 
                  name="is_active" 
                  id="is_active"
                  checked
                  class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
                />
                <label for="is_active" class="ml-2 block text-sm text-gray-900">
                  Active (show on public website)
                </label>
              </div>
            </div>
          </div>
          
          <!-- Contact & Location Tab -->
          <div id="contact-tab" class="tab-panel hidden">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Email</label>
                <input 
                  type="email" 
                  name="email" 
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700">Phone</label>
                <input 
                  type="tel" 
                  name="telephone" 
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
            </div>
            
            <div class="mt-4">
              <label class="block text-sm font-medium text-gray-700">Personal Website URL</label>
              <input 
                type="url" 
                name="url" 
                placeholder="https://example.com"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              />
            </div>
            
            <h4 class="text-md font-medium text-gray-900 mt-6 mb-4">Address Information</h4>
            
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Street Address</label>
                <input 
                  type="text" 
                  name="street_address" 
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
              
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700">City</label>
                  <input 
                    type="text" 
                    name="city" 
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                  />
                </div>
                
                <div>
                  <label class="block text-sm font-medium text-gray-700">State/Region</label>
                  <input 
                    type="text" 
                    name="state" 
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                  />
                </div>
              </div>
              
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700">Postal Code</label>
                  <input 
                    type="text" 
                    name="postal_code" 
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                  />
                </div>
                
                <div>
                  <label class="block text-sm font-medium text-gray-700">Country</label>
                  <input 
                    type="text" 
                    name="country" 
                    placeholder="United States"
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                  />
                </div>
              </div>
            </div>
          </div>
          
          <!-- Professional Tab -->
          <div id="professional-tab" class="tab-panel hidden">
            <div>
              <label class="block text-sm font-medium text-gray-700">Bio/Description</label>
              <textarea 
                name="description" 
                rows="4"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              ></textarea>
            </div>
            
            <div class="mt-4">
              <label class="block text-sm font-medium text-gray-700">Years Experience</label>
              <input 
                type="number" 
                name="years_experience" 
                min="0"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              />
            </div>
            
            <div class="mt-4">
              <label class="block text-sm font-medium text-gray-700">Areas of Expertise</label>
              <input 
                type="text" 
                name="knows_about" 
                placeholder="1031 exchanges, Tax strategy, Real estate (comma-separated)"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              />
              <p class="text-xs text-gray-500 mt-1">Separate multiple areas with commas</p>
            </div>
            
            <div class="mt-4">
              <label class="block text-sm font-medium text-gray-700">Education</label>
              <textarea 
                name="alumni_of" 
                rows="3"
                placeholder="M.B.A., Finance, Harvard Business School&#10;B.S., Economics, Stanford University"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              ></textarea>
              <p class="text-xs text-gray-500 mt-1">Enter one degree per line (e.g., "M.B.A., Finance, Harvard Business School")</p>
            </div>
            
            <div class="mt-4">
              <label class="block text-sm font-medium text-gray-700">Certifications</label>
              <textarea 
                name="certifications" 
                rows="2"
                placeholder="Certified Exchange Specialist (CES)&#10;Certified Public Accountant (CPA)"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              ></textarea>
              <p class="text-xs text-gray-500 mt-1">Enter one certification per line</p>
            </div>
            
            <div class="mt-4">
              <label class="block text-sm font-medium text-gray-700">Awards & Recognition</label>
              <textarea 
                name="awards" 
                rows="2"
                placeholder="Excellence in Client Service Award (2023)&#10;Top Producer Award (2022)"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              ></textarea>
              <p class="text-xs text-gray-500 mt-1">Enter one award per line</p>
            </div>
            
            <div class="mt-4">
              <label class="block text-sm font-medium text-gray-700">Publications</label>
              <textarea 
                name="publications" 
                rows="2"
                placeholder="'Maximizing Your 1031 Exchange' - Real Estate Journal (2023)&#10;'Tax Deferral Strategies' - Investment Weekly (2022)"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              ></textarea>
              <p class="text-xs text-gray-500 mt-1">Enter one publication per line</p>
            </div>
            
            <div class="mt-4">
              <label class="block text-sm font-medium text-gray-700">Specializations</label>
              <input 
                type="text" 
                name="specializations" 
                placeholder="Complex exchanges, Multi-property transactions (comma-separated)"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              />
            </div>
            
            <div class="mt-4">
              <label class="block text-sm font-medium text-gray-700">Languages Spoken</label>
              <input 
                type="text" 
                name="languages_spoken" 
                placeholder="English, Spanish, Mandarin (comma-separated)"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              />
            </div>
          </div>
          
          <!-- Social Media Tab -->
          <div id="social-tab" class="tab-panel hidden">
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">LinkedIn URL</label>
                <input 
                  type="url" 
                  name="linkedin_url" 
                  placeholder="https://linkedin.com/in/username"
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700">Facebook URL</label>
                <input 
                  type="url" 
                  name="facebook_url" 
                  placeholder="https://facebook.com/username"
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700">X (Twitter) URL</label>
                <input 
                  type="url" 
                  name="twitter_url" 
                  placeholder="https://x.com/username"
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700">Other Social Profiles</label>
                <textarea 
                  name="other_social" 
                  rows="3"
                  placeholder="https://instagram.com/username&#10;https://youtube.com/@channel"
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                ></textarea>
                <p class="text-xs text-gray-500 mt-1">Enter one URL per line</p>
              </div>
            </div>
          </div>
          
          <!-- Additional Tab -->
          <div id="additional-tab" class="tab-panel hidden">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Birth Date</label>
                <input 
                  type="date" 
                  name="birth_date" 
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700">Nationality</label>
                <input 
                  type="text" 
                  name="nationality" 
                  placeholder="American"
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
            </div>
            
            <div class="mt-6">
              <p class="text-sm text-gray-600">
                <strong>Note:</strong> Most fields are optional. Only fill in the information you want to display publicly. 
                Empty fields will not appear on the public team page.
              </p>
            </div>
          </div>
        </div>
        
        <div class="flex justify-end space-x-4 pt-4">
          <button 
            type="button" 
            id="cancelBtn"
            class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md"
          >
            Cancel
          </button>
          <button 
            type="submit"
            class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-md"
          >
            Save
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<style>
  .tab-btn {
    transition: all 0.2s ease;
  }
  
  .tab-btn.active {
    color: #2563eb;
    border-color: #2563eb;
  }
  
  .tab-panel {
    animation: fadeIn 0.3s ease;
  }
  
  .tab-panel.hidden {
    display: none;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Modal handling
  const modal = document.getElementById('memberModal');
  const modalTitle = document.getElementById('modalTitle');
  const form = document.getElementById('memberForm') as HTMLFormElement;
  const memberIdInput = document.getElementById('memberId') as HTMLInputElement;
  const addBtn = document.getElementById('addMemberBtn');
  const cancelBtn = document.getElementById('cancelBtn');
  const closeModalBtn = document.getElementById('closeModalBtn');
  
  // Tab handling
  const tabButtons = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');
  
  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-tab');
      
      // Update active tab button
      tabButtons.forEach(b => {
        b.classList.remove('active', 'text-blue-600', 'border-blue-500');
        b.classList.add('text-gray-500', 'border-transparent');
      });
      btn.classList.remove('text-gray-500', 'border-transparent');
      btn.classList.add('active', 'text-blue-600', 'border-blue-500');
      
      // Show corresponding panel
      tabPanels.forEach(panel => {
        if (panel.id === `${targetTab}-tab`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });
  
  // Show modal for adding
  addBtn?.addEventListener('click', () => {
    modalTitle!.textContent = 'Add Team Member';
    form.reset();
    memberIdInput.value = '';
    
    // Reset to first tab
    const firstTab = document.querySelector('.tab-btn[data-tab="basic"]');
    firstTab?.click();
    
    modal?.classList.remove('hidden');
  });
  
  // Show modal for editing
  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const member = JSON.parse((e.target as HTMLElement).dataset.member || '{}');
      modalTitle!.textContent = 'Edit Team Member';
      
      // Populate basic fields
      memberIdInput.value = member.id;
      (form.elements.namedItem('name') as HTMLInputElement).value = member.name || '';
      (form.elements.namedItem('slug') as HTMLInputElement).value = member.slug || '';
      (form.elements.namedItem('job_title') as HTMLInputElement).value = member.job_title || '';
      (form.elements.namedItem('works_for') as HTMLInputElement).value = member.works_for || 'The 1031 Center';
      (form.elements.namedItem('honorific_prefix') as HTMLInputElement).value = member.honorific_prefix || '';
      (form.elements.namedItem('honorific_suffix') as HTMLInputElement).value = member.honorific_suffix || '';
      (form.elements.namedItem('image') as HTMLInputElement).value = member.image || '';
      (form.elements.namedItem('display_order') as HTMLInputElement).value = member.display_order || '0';
      (form.elements.namedItem('is_active') as HTMLInputElement).checked = member.is_active;
      
      // Contact & Location
      (form.elements.namedItem('email') as HTMLInputElement).value = member.email || '';
      (form.elements.namedItem('telephone') as HTMLInputElement).value = member.telephone || '';
      (form.elements.namedItem('url') as HTMLInputElement).value = member.url || '';
      
      // Address fields from JSONB
      if (member.address) {
        (form.elements.namedItem('street_address') as HTMLInputElement).value = member.address.streetAddress || '';
        (form.elements.namedItem('city') as HTMLInputElement).value = member.address.addressLocality || '';
        (form.elements.namedItem('state') as HTMLInputElement).value = member.address.addressRegion || '';
        (form.elements.namedItem('postal_code') as HTMLInputElement).value = member.address.postalCode || '';
        (form.elements.namedItem('country') as HTMLInputElement).value = member.address.addressCountry || '';
      }
      
      // Professional fields
      (form.elements.namedItem('description') as HTMLTextAreaElement).value = member.description || '';
      (form.elements.namedItem('years_experience') as HTMLInputElement).value = member.years_experience || '';
      (form.elements.namedItem('knows_about') as HTMLInputElement).value = member.knows_about?.join(', ') || '';
      (form.elements.namedItem('alumni_of') as HTMLTextAreaElement).value = member.alumni_of?.join('\n') || '';
      (form.elements.namedItem('certifications') as HTMLTextAreaElement).value = member.certifications?.join('\n') || '';
      (form.elements.namedItem('awards') as HTMLTextAreaElement).value = member.awards?.join('\n') || '';
      (form.elements.namedItem('publications') as HTMLTextAreaElement).value = member.publications?.join('\n') || '';
      (form.elements.namedItem('specializations') as HTMLInputElement).value = member.specializations?.join(', ') || '';
      (form.elements.namedItem('languages_spoken') as HTMLInputElement).value = member.languages_spoken?.join(', ') || '';
      
      // Social media - parse from same_as array
      if (member.same_as && member.same_as.length > 0) {
        const linkedinUrl = member.same_as.find((url: string) => url.includes('linkedin.com'));
        const facebookUrl = member.same_as.find((url: string) => url.includes('facebook.com'));
        const twitterUrl = member.same_as.find((url: string) => url.includes('twitter.com') || url.includes('x.com'));
        const otherUrls = member.same_as.filter((url: string) => 
          !url.includes('linkedin.com') && 
          !url.includes('facebook.com') && 
          !url.includes('twitter.com') && 
          !url.includes('x.com')
        );
        
        (form.elements.namedItem('linkedin_url') as HTMLInputElement).value = linkedinUrl || '';
        (form.elements.namedItem('facebook_url') as HTMLInputElement).value = facebookUrl || '';
        (form.elements.namedItem('twitter_url') as HTMLInputElement).value = twitterUrl || '';
        (form.elements.namedItem('other_social') as HTMLTextAreaElement).value = otherUrls.join('\n') || '';
      }
      
      // Additional fields
      (form.elements.namedItem('birth_date') as HTMLInputElement).value = member.birth_date || '';
      (form.elements.namedItem('nationality') as HTMLInputElement).value = member.nationality || '';
      
      // Reset to first tab
      const firstTab = document.querySelector('.tab-btn[data-tab="basic"]');
      firstTab?.click();
      
      modal?.classList.remove('hidden');
    });
  });
  
  // Hide modal
  cancelBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });
  
  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    let data: any = Object.fromEntries(formData);
    
    // Convert checkbox
    data.is_active = formData.has('is_active');
    
    // Convert arrays - ensure they're arrays or null (not empty arrays)
    if (data.knows_about && data.knows_about.trim()) {
      data.knows_about = data.knows_about.split(',').map((s: string) => s.trim()).filter(Boolean);
      if (data.knows_about.length === 0) data.knows_about = null;
    } else {
      data.knows_about = null;
    }
    
    // Process specializations (comma-separated)
    if (data.specializations && data.specializations.trim()) {
      data.specializations = data.specializations.split(',').map((s: string) => s.trim()).filter(Boolean);
      if (data.specializations.length === 0) data.specializations = null;
    } else {
      data.specializations = null;
    }
    
    // Process languages_spoken (comma-separated)
    if (data.languages_spoken && data.languages_spoken.trim()) {
      data.languages_spoken = data.languages_spoken.split(',').map((s: string) => s.trim()).filter(Boolean);
      if (data.languages_spoken.length === 0) data.languages_spoken = null;
    } else {
      data.languages_spoken = null;
    }
    
    // Note: same_as will be handled later when we collect individual social media URLs
    delete data.same_as; // Remove the text field value to avoid conflicts
    
    // Convert numbers - ensure they're numbers or null, never NaN
    if (data.years_experience && data.years_experience.trim()) {
      const parsed = parseInt(data.years_experience);
      data.years_experience = isNaN(parsed) ? null : parsed;
    } else {
      data.years_experience = null;
    }
    
    if (data.display_order && data.display_order.trim()) {
      const parsed = parseInt(data.display_order);
      data.display_order = isNaN(parsed) ? 0 : parsed;
    } else {
      data.display_order = 0; // Default to 0, not null
    }
    
    // Handle required fields - ensure they're never null/empty
    if (!data.name || !data.name.trim()) {
      alert('Name is required');
      return;
    }
    data.name = data.name.trim();
    
    // Auto-generate slug if empty
    if (!data.slug || !data.slug.trim()) {
      data.slug = data.name.toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '') // Remove special characters
        .replace(/\s+/g, '-') // Replace spaces with hyphens
        .replace(/-+/g, '-') // Replace multiple hyphens with single
        .replace(/^-|-$/g, ''); // Remove leading/trailing hyphens
      
      // Ensure slug is not empty after processing
      if (!data.slug) {
        data.slug = 'team-member-' + Date.now();
      }
    } else {
      data.slug = data.slug.trim();
    }
    
    // Format alumni_of (education) from textarea to array
    const alumniOfText = data.alumni_of?.trim();
    if (alumniOfText) {
      data.alumni_of = alumniOfText.split('\n').filter((line: string) => line.trim());
    } else {
      data.alumni_of = null;
    }
    
    // Collect and format social media URLs into same_as array
    const socialUrls = [];
    const socialFields = ['linkedin_url', 'facebook_url', 'twitter_url', 'instagram_url', 'youtube_url'];
    
    socialFields.forEach(field => {
      const url = data[field]?.trim();
      if (url) {
        socialUrls.push(url);
      }
    });
    
    // Set same_as only if we have social URLs
    if (socialUrls.length > 0) {
      data.same_as = socialUrls;
    } else {
      data.same_as = null;
    }
    
    // Remove individual social media fields from data after processing
    socialFields.forEach(field => {
      delete data[field];
    });
    
    // Format address as JSONB
    const addressFields = {
      street_address: data.street_address?.trim(),
      city: data.city?.trim(),
      state: data.state?.trim(),
      postal_code: data.postal_code?.trim(),
      country: data.country?.trim()
    };
    
    const hasAddress = Object.values(addressFields).some(val => val);
    if (hasAddress) {
      data.address = {
        '@type': 'PostalAddress',
        streetAddress: addressFields.street_address || undefined,
        addressLocality: addressFields.city || undefined,
        addressRegion: addressFields.state || undefined,
        postalCode: addressFields.postal_code || undefined,
        addressCountry: addressFields.country || 'US'
      };
      // Remove undefined values from address
      Object.keys(data.address).forEach(key => {
        if (data.address[key] === undefined) {
          delete data.address[key];
        }
      });
    } else {
      data.address = null;
    }
    
    // Remove individual address fields from data - ensure they're deleted
    const addressFieldsToRemove = ['street_address', 'city', 'state', 'postal_code', 'country'];
    addressFieldsToRemove.forEach(field => {
      if (field in data) {
        delete data[field];
      }
    });
    
    // Format other array fields from textareas
    ['certifications', 'awards', 'publications'].forEach(field => {
      const value = data[field]?.trim();
      if (value) {
        data[field] = value.split('\n').filter((line: string) => line.trim());
      } else {
        data[field] = null;
      }
    });
    
    // Clean up empty strings - convert to null (except required fields)
    const requiredFields = ['name', 'slug', 'display_order', 'is_active'];
    Object.keys(data).forEach(key => {
      if (data[key] === '' && !requiredFields.includes(key)) {
        data[key] = null;
      }
    });
    
    // Debug: Log data before cleanup
    console.log('[Admin] Form data before cleanup:', JSON.stringify(data, null, 2));
    
    // Define allowed fields based on database schema
    const allowedFields = [
      'id', 'name', 'slug', 'job_title', 'works_for', 'url', 'image', 
      'description', 'birth_date', 'nationality', 'address', 'telephone', 
      'email', 'same_as', 'knows_about', 'alumni_of', 'honorific_prefix', 
      'honorific_suffix', 'job_title_details', 'awards', 'publications', 
      'certifications', 'languages_spoken', 'years_experience', 
      'specializations', 'display_order', 'is_active'
    ];
    
    // Remove any fields not in the allowed list
    const cleanedData: any = {};
    Object.keys(data).forEach(key => {
      if (allowedFields.includes(key) && data[key] !== undefined) {
        cleanedData[key] = data[key];
      } else if (!allowedFields.includes(key)) {
        console.warn(`[Admin] Removing unauthorized field: ${key}`);
      }
    });
    
    // Replace data with cleaned data
    data = cleanedData;
    
    console.log('[Admin] Form data after cleanup:', JSON.stringify(data, null, 2));
    
    try {
      const isUpdate = !!data.id;
      const url = '/api/team-members';
      const method = isUpdate ? 'PATCH' : 'POST';
      
      console.log(`[Admin] Sending ${method} to ${url}`, data);
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      console.log(`[Admin] Response status: ${response.status}`);
      
      let result;
      try {
        result = await response.json();
        console.log('[Admin] Response data:', result);
      } catch (e) {
        console.error('[Admin] Failed to parse response as JSON:', e);
        result = { success: false, error: 'Invalid response from server' };
      }
      
      if (response.ok && result.success) {
        console.log('[Admin] Update successful, reloading page...');
        // Add a delay to ensure the update is committed and propagated
        setTimeout(() => {
          window.location.reload();
        }, 500);
      } else {
        console.error('[Admin] Update failed:', result);
        alert('Error: ' + (result.error || result.details || 'Failed to save'));
      }
    } catch (error) {
      alert('Error: Failed to save team member');
      console.error(error);
    }
  });
  
  // Real-time slug generation
  const nameInput = form?.querySelector('input[name="name"]') as HTMLInputElement;
  const slugInput = form?.querySelector('#slugInput') as HTMLInputElement;
  
  function generateSlug(name: string): string {
    return name.toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '') // Remove special characters
      .replace(/\s+/g, '-') // Replace spaces with hyphens
      .replace(/-+/g, '-') // Replace multiple hyphens with single
      .replace(/^-|-$/g, ''); // Remove leading/trailing hyphens
  }
  
  nameInput?.addEventListener('input', (e) => {
    const name = (e.target as HTMLInputElement).value;
    if (name && (!slugInput.value || slugInput.dataset.autoGenerated === 'true')) {
      const generatedSlug = generateSlug(name);
      slugInput.value = generatedSlug;
      slugInput.dataset.autoGenerated = 'true';
      slugInput.style.fontStyle = 'italic';
      slugInput.style.color = '#6b7280'; // gray-500
    }
  });
  
  slugInput?.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.value) {
      input.dataset.autoGenerated = 'false';
      input.style.fontStyle = 'normal';
      input.style.color = '';
    } else {
      input.dataset.autoGenerated = 'true';
    }
  });
  
  // Handle activate/deactivate
  document.querySelectorAll('.toggle-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const id = target.dataset.id;
      const isActive = target.dataset.active === 'true';
      
      if (confirm(`Are you sure you want to ${isActive ? 'deactivate' : 'activate'} this team member?`)) {
        try {
          console.log('[Admin] Toggling status for:', { id, is_active: !isActive });
          
          const response = await fetch('/api/team-members', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, is_active: !isActive })
          });
          
          console.log(`[Admin] Toggle response status: ${response.status}`);
          const result = await response.json();
          console.log('[Admin] Toggle response data:', result);
          
          if (response.ok && result.success) {
            window.location.reload();
          } else {
            alert('Error: ' + (result.error || result.details || 'Failed to update status'));
          }
        } catch (error) {
          alert('Error: Failed to update status');
          console.error(error);
        }
      }
    });
  });
</script>


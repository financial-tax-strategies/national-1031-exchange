---
import AdminLayout from '../../layouts/AdminLayout.astro';

// In production, add authentication check here
---

<AdminLayout title="SEO & Analytics Configuration">
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">SEO & Analytics Configuration</h1>
        <button 
          id="saveConfig" 
          class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors"
        >
          Save Configuration
        </button>
      </div>

      <!-- Tabs -->
      <div class="border-b border-gray-200 mb-8">
        <nav class="-mb-px flex space-x-8">
          <button class="tab-button active" data-tab="analytics">
            Analytics IDs
          </button>
          <button class="tab-button" data-tab="meta">
            Meta Defaults
          </button>
          <button class="tab-button" data-tab="schema">
            Schema Settings
          </button>
          <button class="tab-button" data-tab="ai-bots">
            AI Bot Access
          </button>
          <button class="tab-button" data-tab="testing">
            Testing Tools
          </button>
        </nav>
      </div>

      <!-- Tab Content -->
      <div id="analytics" class="tab-content">
        <div class="bg-white p-6 rounded-lg shadow">
          <h2 class="text-xl font-semibold mb-6">Analytics & Tracking IDs</h2>
          
          <div class="space-y-6">
            <!-- Google Analytics -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Google Analytics 4 Measurement ID
              </label>
              <input
                type="text"
                id="ga4Id"
                placeholder="G-XXXXXXXXXX"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
              <p class="text-sm text-gray-500 mt-1">Format: G-XXXXXXXXXX</p>
            </div>

            <!-- Google Tag Manager -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Google Tag Manager Container ID
              </label>
              <input
                type="text"
                id="gtmId"
                placeholder="GTM-XXXXXXX"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
              <p class="text-sm text-gray-500 mt-1">Format: GTM-XXXXXXX</p>
            </div>

            <!-- Facebook Pixel -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Facebook Pixel ID
              </label>
              <input
                type="text"
                id="fbPixelId"
                placeholder="XXXXXXXXXXXXXXXX"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>

            <!-- LinkedIn Insight Tag -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                LinkedIn Insight Tag Partner ID
              </label>
              <input
                type="text"
                id="linkedInId"
                placeholder="XXXXXXX"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>

            <!-- Twitter Pixel -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Twitter Pixel ID
              </label>
              <input
                type="text"
                id="twitterPixelId"
                placeholder="XXXXX"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>

            <!-- Microsoft Clarity -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Microsoft Clarity Project ID
              </label>
              <input
                type="text"
                id="clarityId"
                placeholder="XXXXXXXXXX"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>

            <!-- Hotjar -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Hotjar Site ID
              </label>
              <input
                type="text"
                id="hotjarId"
                placeholder="XXXXXXX"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>
          </div>
        </div>
      </div>

      <div id="meta" class="tab-content hidden">
        <div class="bg-white p-6 rounded-lg shadow">
          <h2 class="text-xl font-semibold mb-6">Default Meta Information</h2>
          
          <div class="space-y-6">
            <!-- Default Description -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Default Meta Description (150-155 characters)
              </label>
              <textarea
                id="defaultDescription"
                rows="3"
                maxlength="155"
                placeholder="America's most trusted 1031 exchange qualified intermediary..."
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              ></textarea>
              <p class="text-sm text-gray-500 mt-1">
                <span id="descriptionCount">0</span>/155 characters
              </p>
            </div>

            <!-- Default Author -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Default Author Information
              </label>
              <input
                type="text"
                id="defaultAuthor"
                placeholder="Ruth Benjamin, Capital Gains Tax Strategist"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>

            <!-- Default Keywords -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Default Keywords (comma separated)
              </label>
              <input
                type="text"
                id="defaultKeywords"
                placeholder="1031 exchange, capital gains tax deferral, like-kind exchange"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>

            <!-- Social Media Default Image -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Default Social Media Image URL
              </label>
              <input
                type="text"
                id="defaultOgImage"
                placeholder="/images/og-image.jpg"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>
          </div>
        </div>
      </div>

      <div id="schema" class="tab-content hidden">
        <div class="bg-white p-6 rounded-lg shadow">
          <h2 class="text-xl font-semibold mb-6">Schema.org Organization Settings</h2>
          
          <div class="space-y-6">
            <!-- Organization Name -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Organization Name
              </label>
              <input
                type="text"
                id="orgName"
                placeholder="National 1031 Center"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>

            <!-- Legal Name -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Legal Name
              </label>
              <input
                type="text"
                id="orgLegalName"
                placeholder="National 1031 Center, LLC"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>

            <!-- Social Media Profiles -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Social Media Profiles
              </label>
              <div class="space-y-2">
                <input
                  type="text"
                  id="socialFacebook"
                  placeholder="https://facebook.com/national1031center"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                />
                <input
                  type="text"
                  id="socialLinkedIn"
                  placeholder="https://linkedin.com/company/national1031center"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                />
                <input
                  type="text"
                  id="socialTwitter"
                  placeholder="https://twitter.com/national1031"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                />
                <input
                  type="text"
                  id="socialYouTube"
                  placeholder="https://youtube.com/@national1031center"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                />
              </div>
            </div>

            <!-- Price Range -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Price Range
              </label>
              <select
                id="priceRange"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              >
                <option value="$">$ - Budget</option>
                <option value="$$" selected>$$ - Moderate</option>
                <option value="$$$">$$$ - Premium</option>
                <option value="$$$$">$$$$ - Luxury</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div id="ai-bots" class="tab-content hidden">
        <div class="bg-white p-6 rounded-lg shadow">
          <h2 class="text-xl font-semibold mb-6">AI Bot Access Control</h2>
          
          <div class="space-y-4">
            <!-- Bot toggles -->
            <div class="flex items-center justify-between">
              <span class="font-medium">GPTBot (OpenAI)</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="botGPT" class="sr-only peer" checked>
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div class="flex items-center justify-between">
              <span class="font-medium">Claude-Web (Anthropic)</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="botClaude" class="sr-only peer" checked>
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div class="flex items-center justify-between">
              <span class="font-medium">PerplexityBot</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="botPerplexity" class="sr-only peer" checked>
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div class="flex items-center justify-between">
              <span class="font-medium">YouBot</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="botYou" class="sr-only peer" checked>
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div class="flex items-center justify-between">
              <span class="font-medium">Cohere AI</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="botCohere" class="sr-only peer" checked>
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>
          </div>

          <div class="mt-8">
            <h3 class="text-lg font-medium mb-4">llms.txt Content Preview</h3>
            <div class="bg-gray-50 p-4 rounded-lg">
              <p class="text-sm text-gray-600">
                The llms.txt file has been created at <code>/llms.txt</code> and contains comprehensive information about your services for AI understanding.
              </p>
              <a href="/llms.txt" target="_blank" class="text-blue-600 hover:text-blue-700 text-sm mt-2 inline-block">
                View llms.txt →
              </a>
            </div>
          </div>
        </div>
      </div>

      <div id="testing" class="tab-content hidden">
        <div class="bg-white p-6 rounded-lg shadow">
          <h2 class="text-xl font-semibold mb-6">SEO Testing Tools</h2>
          
          <div class="space-y-6">
            <!-- Schema Validator -->
            <div>
              <h3 class="text-lg font-medium mb-3">Schema Markup Validator</h3>
              <button class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors">
                Validate All Schema
              </button>
              <div id="schemaResults" class="mt-4"></div>
            </div>

            <!-- Meta Tag Preview -->
            <div>
              <h3 class="text-lg font-medium mb-3">Meta Tag Preview</h3>
              <select id="pageSelect" class="w-full px-4 py-2 border border-gray-300 rounded-lg mb-4">
                <option value="/">Homepage</option>
                <option value="/services/delayed-exchange">Delayed Exchange</option>
                <option value="/services/reverse-exchange">Reverse Exchange</option>
                <option value="/calculator">Calculator</option>
              </select>
              <div id="metaPreview" class="bg-gray-50 p-4 rounded-lg"></div>
            </div>

            <!-- Sitemap Status -->
            <div>
              <h3 class="text-lg font-medium mb-3">Sitemap Status</h3>
              <div class="bg-gray-50 p-4 rounded-lg">
                <p class="text-sm text-gray-600">
                  Sitemap location: <code>/sitemap-index.xml</code>
                </p>
                <a href="/sitemap-index.xml" target="_blank" class="text-blue-600 hover:text-blue-700 text-sm mt-2 inline-block">
                  View Sitemap →
                </a>
              </div>
            </div>

            <!-- robots.txt Status -->
            <div>
              <h3 class="text-lg font-medium mb-3">robots.txt Configuration</h3>
              <div class="bg-gray-50 p-4 rounded-lg">
                <p class="text-sm text-gray-600">
                  All AI bots have been granted access with 0 crawl delay for priority indexing.
                </p>
                <a href="/robots.txt" target="_blank" class="text-blue-600 hover:text-blue-700 text-sm mt-2 inline-block">
                  View robots.txt →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Load existing configuration on page load
    async function loadConfiguration() {
      try {
        const response = await fetch('/api/seo-config');
        const result = await response.json();
        
        if (result.data) {
          const config = result.data;
          
          // Load analytics settings
          if (config.analytics) {
            document.getElementById('ga4Id').value = config.analytics.ga4_id || '';
            document.getElementById('gtmId').value = config.analytics.gtm_id || '';
            document.getElementById('fbPixelId').value = config.analytics.fb_pixel_id || '';
            document.getElementById('linkedInId').value = config.analytics.linkedin_id || '';
            document.getElementById('twitterPixelId').value = config.analytics.twitter_pixel_id || '';
            document.getElementById('clarityId').value = config.analytics.clarity_id || '';
            document.getElementById('hotjarId').value = config.analytics.hotjar_id || '';
          }
          
          // Load meta settings
          if (config.meta) {
            document.getElementById('defaultDescription').value = config.meta.default_description || '';
            document.getElementById('defaultAuthor').value = config.meta.default_author || '';
            document.getElementById('defaultKeywords').value = config.meta.default_keywords || '';
            document.getElementById('defaultOgImage').value = config.meta.default_og_image || '';
            
            // Update character counter
            const descriptionInput = document.getElementById('defaultDescription');
            const descriptionCount = document.getElementById('descriptionCount');
            if (descriptionInput && descriptionCount) {
              descriptionCount.textContent = descriptionInput.value.length;
            }
          }
          
          // Load schema settings
          if (config.schema) {
            document.getElementById('orgName').value = config.schema.org_name || '';
            document.getElementById('orgLegalName').value = config.schema.org_legal_name || '';
            document.getElementById('socialFacebook').value = config.schema.social_facebook || '';
            document.getElementById('socialLinkedIn').value = config.schema.social_linkedin || '';
            document.getElementById('socialTwitter').value = config.schema.social_twitter || '';
            document.getElementById('socialYouTube').value = config.schema.social_youtube || '';
            document.getElementById('priceRange').value = config.schema.price_range || '$$';
          }
          
          // Load AI bot settings
          if (config.ai_bots) {
            document.getElementById('botGPT').checked = config.ai_bots.gpt_bot !== false;
            document.getElementById('botClaude').checked = config.ai_bots.claude_web !== false;
            document.getElementById('botPerplexity').checked = config.ai_bots.perplexity_bot !== false;
            document.getElementById('botYou').checked = config.ai_bots.you_bot !== false;
            document.getElementById('botCohere').checked = config.ai_bots.cohere_ai !== false;
          }
        }
      } catch (error) {
        console.error('Failed to load configuration:', error);
      }
    }

    // Tab switching
    document.querySelectorAll('.tab-button').forEach(button => {
      button.addEventListener('click', () => {
        const tab = button.dataset.tab;
        
        // Update active tab
        document.querySelectorAll('.tab-button').forEach(b => b.classList.remove('active'));
        button.classList.add('active');
        
        // Show corresponding content
        document.querySelectorAll('.tab-content').forEach(content => {
          content.classList.add('hidden');
        });
        document.getElementById(tab).classList.remove('hidden');
      });
    });

    // Character counter for meta description
    const descriptionInput = document.getElementById('defaultDescription');
    const descriptionCount = document.getElementById('descriptionCount');
    
    if (descriptionInput) {
      descriptionInput.addEventListener('input', () => {
        descriptionCount.textContent = descriptionInput.value.length;
      });
    }

    // Save configuration
    document.getElementById('saveConfig').addEventListener('click', async () => {
      const saveButton = document.getElementById('saveConfig');
      const originalText = saveButton.textContent;
      
      // Disable button and show loading state
      saveButton.disabled = true;
      saveButton.textContent = 'Saving...';
      
      const config = {
        analytics: {
          ga4_id: document.getElementById('ga4Id').value,
          gtm_id: document.getElementById('gtmId').value,
          fb_pixel_id: document.getElementById('fbPixelId').value,
          linkedin_id: document.getElementById('linkedInId').value,
          twitter_pixel_id: document.getElementById('twitterPixelId').value,
          clarity_id: document.getElementById('clarityId').value,
          hotjar_id: document.getElementById('hotjarId').value,
        },
        meta: {
          default_description: document.getElementById('defaultDescription').value,
          default_author: document.getElementById('defaultAuthor').value,
          default_keywords: document.getElementById('defaultKeywords').value,
          default_og_image: document.getElementById('defaultOgImage').value,
        },
        schema: {
          org_name: document.getElementById('orgName').value,
          org_legal_name: document.getElementById('orgLegalName').value,
          social_facebook: document.getElementById('socialFacebook').value,
          social_linkedin: document.getElementById('socialLinkedIn').value,
          social_twitter: document.getElementById('socialTwitter').value,
          social_youtube: document.getElementById('socialYouTube').value,
          price_range: document.getElementById('priceRange').value,
        },
        ai_bots: {
          gpt_bot: document.getElementById('botGPT').checked,
          claude_web: document.getElementById('botClaude').checked,
          perplexity_bot: document.getElementById('botPerplexity').checked,
          you_bot: document.getElementById('botYou').checked,
          cohere_ai: document.getElementById('botCohere').checked,
        }
      };

      try {
        // Save configuration via API
        const response = await fetch('/api/seo-config', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(config)
        });

        const result = await response.json();
        
        if (response.ok && result.success) {
          // Show success message
          alert('Configuration saved successfully!');
          console.log('Configuration saved:', result.data);
        } else {
          // Show error message
          const errorMessage = result.message || result.error || 'Failed to save configuration';
          alert(`Error: ${errorMessage}`);
          console.error('Save failed:', result);
          
          // If database is not configured, show additional help
          if (response.status === 503 && result.sql) {
            console.log('To enable saving, create the following table in Supabase:');
            console.log(result.sql);
          }
        }
      } catch (error) {
        // Show network error
        alert('Network error: Failed to save configuration');
        console.error('Network error:', error);
      } finally {
        // Re-enable button
        saveButton.disabled = false;
        saveButton.textContent = originalText;
      }
    });
    
    // Load configuration when page loads
    document.addEventListener('DOMContentLoaded', loadConfiguration);
  </script>

  <style>
    .tab-button {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
      padding-left: 0.25rem;
      padding-right: 0.25rem;
      border-bottom-width: 2px;
      border-color: transparent;
      font-weight: 500;
      font-size: 0.875rem;
      line-height: 1.25rem;
      color: rgb(107 114 128);
      cursor: pointer;
      transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      transition-duration: 150ms;
    }
    
    .tab-button:hover {
      color: rgb(55 65 81);
      border-color: rgb(209 213 219);
    }
    
    .tab-button.active {
      color: rgb(37 99 235);
      border-color: rgb(37 99 235);
    }
  </style>
</AdminLayout>
---
// Simple test page to check environment
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const hasSupabaseKey = !!import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<html>
  <head>
    <title>Environment Test</title>
  </head>
  <body>
    <h1>Environment Variables Check</h1>
    <ul>
      <li>Supabase URL: {supabaseUrl || 'NOT SET'}</li>
      <li>Supabase Anon Key: {hasSupabaseKey ? 'SET' : 'NOT SET'}</li>
      <li>Environment Mode: {import.meta.env.MODE}</li>
    </ul>
    
    <p>If these are not set, please check your .env.local file</p>
    
    <a href="/admin">Back to Admin</a>
  </body>
</html>
---
/**
 * Admin Login Page
 * For staff to access the admin dashboard
 */

import Layout from '../../layouts/Layout.astro';
import { LoginForm } from '../../components/auth/LoginForm';
import { AuthService } from '../../lib/services/auth.service';

// Check if user is already logged in
const authService = AuthService.getInstance();
const userResponse = await authService.getCurrentUser();

if (userResponse.success && userResponse.data && userResponse.data.adminProfile) {
  // Redirect to admin dashboard if already logged in
  return Astro.redirect('/admin');
}

const pageTitle = 'Admin Login - National 1031 Exchange Center';
const pageDescription = 'Admin login for National 1031 Exchange Center staff.';
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  noindex={true}
>
  <main class="min-h-screen bg-gray-100 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
      <div class="text-center mb-8">
        <img 
          src="/logo.png" 
          alt="National 1031 Exchange Center" 
          class="mx-auto h-12 w-auto"
        />
        <h1 class="mt-6 text-3xl font-extrabold text-gray-900">
          Admin Dashboard
        </h1>
        <p class="mt-2 text-sm text-gray-600">
          Staff access only
        </p>
      </div>
      
      <LoginForm 
        client:load 
        redirectUrl="/admin" 
        isAdminLogin={true}
      />
      
      <div class="mt-8 text-center">
        <div class="bg-blue-50 border border-blue-200 rounded-md p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-blue-800">
                Security Notice
              </h3>
              <div class="mt-2 text-sm text-blue-700">
                <p>
                  This is a secure area for authorized staff only. 
                  All login attempts are monitored and logged.
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="mt-6 text-sm text-gray-600">
          <p>
            Having trouble logging in? Contact your system administrator.
          </p>
        </div>
      </div>
    </div>
    
    <footer class="mt-8 text-center text-xs text-gray-500">
      <p>&copy; {new Date().getFullYear()} National 1031 Exchange Center. All rights reserved.</p>
      <p class="mt-1">
        <a href="/" class="hover:text-gray-700">Back to main site</a>
      </p>
    </footer>
  </main>
</Layout>

<style>
  /* Override any global styles for admin login page */
  main {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
</style>
---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase, isSupabaseConfigured } from '../../lib/supabase';

// Debug information
const debugInfo = {
  environment: import.meta.env.MODE,
  isProduction: import.meta.env.PROD,
  isDevelopment: import.meta.env.DEV,
  nodeEnv: process.env.NODE_ENV || 'NOT SET',
  hostname: typeof window !== 'undefined' ? window.location.hostname : 'SERVER SIDE',
  publicGtmId: import.meta.env.PUBLIC_GTM_ID || 'NOT SET',
  publicEnableGtmDev: import.meta.env.PUBLIC_ENABLE_GTM_DEV || 'NOT SET',
  supabaseConfigured: isSupabaseConfigured(),
  databaseGtmId: null,
  databaseError: null
};

// Try to load from database
if (isSupabaseConfigured()) {
  try {
    const { data, error } = await supabase
      .from('seo_config')
      .select('analytics')
      .eq('tenant_id', 'default')
      .single();
    
    if (error) {
      debugInfo.databaseError = error.message;
    } else if (data && data.analytics) {
      debugInfo.databaseGtmId = data.analytics.gtm_id || 'NOT SET IN DB';
    }
  } catch (error) {
    debugInfo.databaseError = error.message;
  }
}

// Calculate what GTM will use
const GTM_ID = debugInfo.databaseGtmId || debugInfo.publicGtmId;
const hasValidGTM = GTM_ID && GTM_ID !== 'GTM-XXXXXXX' && GTM_ID !== 'NOT SET' && GTM_ID !== 'NOT SET IN DB';
const enableGTMInDev = debugInfo.publicEnableGtmDev === 'true';
const shouldLoadGTM = hasValidGTM && (debugInfo.isProduction || enableGTMInDev);
---

<AdminLayout title="GTM Debug Information">
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl font-bold mb-8">Google Tag Manager Debug Information</h1>
      
      <div class="bg-white rounded-lg shadow p-6 space-y-4">
        <h2 class="text-xl font-semibold mb-4">Environment Info</h2>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <strong>Environment Mode:</strong>
            <span class="ml-2 font-mono">{debugInfo.environment}</span>
          </div>
          
          <div>
            <strong>Is Production:</strong>
            <span class={`ml-2 font-bold ${debugInfo.isProduction ? 'text-green-600' : 'text-yellow-600'}`}>
              {String(debugInfo.isProduction)}
            </span>
          </div>
          
          <div>
            <strong>Is Development:</strong>
            <span class="ml-2 font-mono">{String(debugInfo.isDevelopment)}</span>
          </div>
          
          <div>
            <strong>Supabase Configured:</strong>
            <span class={`ml-2 font-bold ${debugInfo.supabaseConfigured ? 'text-green-600' : 'text-red-600'}`}>
              {String(debugInfo.supabaseConfigured)}
            </span>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6 space-y-4 mt-6">
        <h2 class="text-xl font-semibold mb-4">GTM Configuration</h2>
        
        <div class="space-y-3">
          <div>
            <strong>ENV Variable (PUBLIC_GTM_ID):</strong>
            <span class="ml-2 font-mono bg-gray-100 px-2 py-1 rounded">{debugInfo.publicGtmId}</span>
          </div>
          
          <div>
            <strong>Database GTM ID:</strong>
            <span class="ml-2 font-mono bg-gray-100 px-2 py-1 rounded">{debugInfo.databaseGtmId || 'NOT LOADED'}</span>
          </div>
          
          {debugInfo.databaseError && (
            <div>
              <strong>Database Error:</strong>
              <span class="ml-2 text-red-600">{debugInfo.databaseError}</span>
            </div>
          )}
          
          <div>
            <strong>Dev Mode Flag (PUBLIC_ENABLE_GTM_DEV):</strong>
            <span class="ml-2 font-mono bg-gray-100 px-2 py-1 rounded">{debugInfo.publicEnableGtmDev}</span>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6 space-y-4 mt-6">
        <h2 class="text-xl font-semibold mb-4">GTM Loading Decision</h2>
        
        <div class="space-y-3">
          <div>
            <strong>Final GTM ID to Use:</strong>
            <span class={`ml-2 font-mono px-2 py-1 rounded ${GTM_ID && GTM_ID !== 'NOT SET' ? 'bg-green-100' : 'bg-red-100'}`}>
              {GTM_ID}
            </span>
          </div>
          
          <div>
            <strong>Has Valid GTM ID:</strong>
            <span class={`ml-2 font-bold ${hasValidGTM ? 'text-green-600' : 'text-red-600'}`}>
              {String(hasValidGTM)}
            </span>
          </div>
          
          <div>
            <strong>GTM Dev Mode Enabled:</strong>
            <span class={`ml-2 font-bold ${enableGTMInDev ? 'text-green-600' : 'text-gray-600'}`}>
              {String(enableGTMInDev)}
            </span>
          </div>
          
          <div class="pt-4 border-t">
            <strong class="text-lg">Will GTM Load?</strong>
            <span class={`ml-2 text-xl font-bold ${shouldLoadGTM ? 'text-green-600' : 'text-red-600'}`}>
              {shouldLoadGTM ? '✅ YES' : '❌ NO'}
            </span>
          </div>
          
          {!shouldLoadGTM && (
            <div class="mt-4 p-4 bg-yellow-50 border border-yellow-200 rounded">
              <strong>Why GTM Won't Load:</strong>
              <ul class="list-disc list-inside mt-2">
                {!hasValidGTM && <li>No valid GTM ID found (check database and env variables)</li>}
                {hasValidGTM && !debugInfo.isProduction && !enableGTMInDev && 
                  <li>In development mode without PUBLIC_ENABLE_GTM_DEV=true</li>}
              </ul>
            </div>
          )}
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6 mt-6">
        <h2 class="text-xl font-semibold mb-4">Quick Actions</h2>
        
        <div class="space-y-3">
          <a href="/admin/seo-analytics" class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            Configure SEO Analytics →
          </a>
          
          <div class="mt-4">
            <strong>To Fix on Netlify:</strong>
            <ol class="list-decimal list-inside mt-2 space-y-1">
              <li>Ensure GTM ID is saved in database via /admin/seo-analytics</li>
              <li>OR add PUBLIC_GTM_ID environment variable in Netlify settings</li>
              <li>Redeploy after adding environment variables</li>
            </ol>
          </div>
        </div>
      </div>

      <div class="bg-gray-100 rounded-lg p-4 mt-6 text-sm">
        <strong>Testing GTM:</strong>
        <p class="mt-1">After GTM loads, test with:</p>
        <ul class="list-disc list-inside mt-1">
          <li>Google Tag Assistant Chrome Extension</li>
          <li>GTM Preview Mode (click Preview in GTM container)</li>
          <li>Browser DevTools Console (look for dataLayer)</li>
        </ul>
      </div>
    </div>
  </main>
</AdminLayout>
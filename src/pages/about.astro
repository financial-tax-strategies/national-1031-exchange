---
import Layout from '../layouts/Layout.astro';
import { COMPANY, getFullAddress } from '../config/company';
---

<Layout 
  title={`About ${COMPANY.name} | America's Trusted Exchange Partner`}
  description={`Learn about ${COMPANY.name}, America's most trusted 1031 exchange qualified intermediary. Industry-leading security, expert team, and nationwide service since 2024.`}
>
  
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-blue-900 via-blue-800 to-blue-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          About {COMPANY.name}
        </h1>
        <p class="text-xl text-blue-100">
          America's most trusted 1031 exchange qualified intermediary, dedicated to protecting 
          your wealth and maximizing your investment potential through tax-deferred exchanges.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Mission & Values -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Our Mission</h2>
        <p class="text-xl text-gray-700">
          To provide investors with the most secure, efficient, and compliant 1031 exchange 
          services in the industry, enabling them to build and preserve wealth through 
          strategic tax deferral.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Security First</h3>
          <p class="text-gray-600">
            Bonded & insured with segregated accounts and daily 
            reconciliation protect your funds at every step.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Expert Guidance</h3>
          <p class="text-gray-600">
            Certified Exchange Specialists, attorneys, and CPAs on staff ensure your 
            exchange is structured for maximum benefit and compliance.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-20 h-20 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Speed & Efficiency</h3>
          <p class="text-gray-600">
            48-hour response guarantee, streamlined processes, and technology-driven 
            solutions ensure your exchange moves quickly and smoothly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Company Story -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Our Story</h2>
        
        <div class="prose prose-lg max-w-none text-gray-700">
          <p>
            Founded in 2024, {COMPANY.name} was established to address a critical need in the 
            real estate investment community: a qualified intermediary that combines unparalleled 
            security with genuine expertise and personalized service.
          </p>
          
          <p>
            Our founders recognized that while 1031 exchanges offer tremendous tax benefits, the 
            complexity of regulations and the risk of costly mistakes were preventing many investors 
            from taking advantage of this powerful wealth-building tool. They set out to create a 
            company that would not only facilitate exchanges but educate and empower investors 
            throughout the process.
          </p>
          
          <p>
            Today, {COMPANY.name} stands as America's most trusted exchange partner, having 
            successfully facilitated over 10,000 exchanges nationwide. Our commitment to security, 
            expertise, and service excellence has made us the preferred choice for individual 
            investors, real estate professionals, and institutional clients alike.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership Team -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-12 text-center">Leadership Team</h2>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-32 h-32 bg-gray-300 rounded-full mx-auto mb-4"></div>
          <h3 class="text-xl font-semibold text-gray-900">John Smith, CES</h3>
          <p class="text-blue-600 mb-2">Chief Executive Officer</p>
          <p class="text-gray-600 text-sm">
            30+ years in real estate investment and tax strategy. Certified Exchange Specialist 
            and recognized industry leader.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-32 h-32 bg-gray-300 rounded-full mx-auto mb-4"></div>
          <h3 class="text-xl font-semibold text-gray-900">Sarah Johnson, JD</h3>
          <p class="text-blue-600 mb-2">Chief Legal Officer</p>
          <p class="text-gray-600 text-sm">
            Former IRS attorney with 20+ years specializing in 1031 exchanges and tax law. 
            Ensures complete regulatory compliance.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-32 h-32 bg-gray-300 rounded-full mx-auto mb-4"></div>
          <h3 class="text-xl font-semibold text-gray-900">Michael Chen, CPA</h3>
          <p class="text-blue-600 mb-2">Chief Financial Officer</p>
          <p class="text-gray-600 text-sm">
            CPA with extensive experience in real estate taxation and financial security. 
            Oversees our industry-leading fund protection.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- By the Numbers -->
  <section class="py-16 bg-blue-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-12">{COMPANY.name} by the Numbers</h2>
      
      <div class="grid md:grid-cols-4 gap-8 text-center">
        <div>
          <p class="text-4xl font-bold text-yellow-400 mb-2">Bonded</p>
          <p class="text-lg">& Insured</p>
        </div>
        <div>
          <p class="text-5xl font-bold text-yellow-400 mb-2">10,000+</p>
          <p class="text-lg">Successful Exchanges</p>
        </div>
        <div>
          <p class="text-5xl font-bold text-yellow-400 mb-2">50</p>
          <p class="text-lg">States Licensed</p>
        </div>
        <div>
          <p class="text-5xl font-bold text-yellow-400 mb-2">24/7</p>
          <p class="text-lg">Emergency Support</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Security & Compliance -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Security & Compliance</h2>
      
      <div class="max-w-4xl mx-auto">
        <div class="bg-gray-50 rounded-lg p-8 mb-8">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Industry-Leading Protection</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-green-500 mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold text-gray-900">Bonded & Insured</p>
                <p class="text-gray-600">Comprehensive protection for your funds</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-green-500 mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold text-gray-900">Segregated Accounts</p>
                <p class="text-gray-600">Client funds never commingled, held in FDIC-insured accounts</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-green-500 mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold text-gray-900">Daily Reconciliation</p>
                <p class="text-gray-600">Every account balanced daily with third-party verification</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-green-500 mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold text-gray-900">Parent Company Guarantee</p>
                <p class="text-gray-600">Additional layer of financial protection for peace of mind</p>
              </div>
            </li>
          </ul>
        </div>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Licenses & Certifications</h3>
            <ul class="space-y-2 text-gray-700">
              <li>• Service in all 50 states</li>
              <li>• Federation of Exchange Accommodators member</li>
              <li>• State insurance department approved</li>
              <li>• Annual third-party audits</li>
            </ul>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Professional Affiliations</h3>
            <ul class="space-y-2 text-gray-700">
              <li>• American Bar Association</li>
              <li>• National Association of Realtors</li>
              <li>• American Institute of CPAs</li>
              <li>• Real Estate Investment Association</li>
              <li>• National Apartment Association</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        Ready to Experience the Difference?
      </h2>
      <p class="text-xl text-gray-700 mb-8">
        Join thousands of investors who trust {COMPANY.name} for their exchange needs.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="bg-blue-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-700 transition-all duration-300 transform hover:scale-105">
          Start Your Exchange
        </a>
        <a href="/calculator" class="border-2 border-blue-600 text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-600 hover:text-white transition-all duration-300">
          Calculate Your Savings
        </a>
      </div>
    </div>
  </section>
  
  <!-- Schema Markup -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "${COMPANY.name}",
    "alternateName": "The 1031 Exchange Center",
    "url": "https://the1031center.com",
    "logo": "https://the1031center.com/images/logo.png",
    "description": "America's most trusted 1031 exchange qualified intermediary, facilitating tax-deferred property exchanges nationwide with industry-leading security and expertise.",
    "foundingDate": "2024",
    "founder": {
      "@type": "Person",
      "name": "John Smith",
      "jobTitle": "Chief Executive Officer"
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "${COMPANY.address.street}",
      "addressLocality": "${COMPANY.address.city}",
      "addressRegion": "${COMPANY.address.state}",
      "postalCode": "${COMPANY.address.zip}",
      "addressCountry": "${COMPANY.address.countryCode}"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+1${COMPANY.phone.mainFormatted}",
      "contactType": "customer service",
      "areaServed": "US",
      "availableLanguage": ["English", "Spanish"]
    },
    "sameAs": [
      "https://www.linkedin.com/company/the1031center",
      "https://www.facebook.com/the1031center",
      "https://twitter.com/the1031center"
    ],
    "numberOfEmployees": {
      "@type": "QuantitativeValue",
      "value": 50
    },
    "slogan": "America's Most Trusted 1031 Exchange Partner",
    "areaServed": {
      "@type": "Country",
      "name": "United States"
    },
    "award": [
      "Federation of Exchange Accommodators Member"
    ]
  }
  </script>
</Layout>
---
import Layout from '../layouts/Layout.astro';
import { COMPANY } from '../config/company';
---

<Layout 
  title={`Terms of Service | ${COMPANY.name}`}
  description={`Terms of Service for ${COMPANY.name}. Learn about the terms and conditions governing the use of our 1031 exchange services and website.`}
>
  
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-blue-900 via-blue-800 to-blue-900 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          Terms of Service
        </h1>
        <p class="text-xl text-blue-100">
          Please read these terms carefully before using our services.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Legal Content Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Last Updated Notice -->
      <div class="mb-8 p-4 bg-blue-50 border-l-4 border-blue-500 rounded">
        <p class="text-sm text-blue-900">
          <strong>Last Updated:</strong> <span id="termageddon-last-updated">[Date will be automatically updated by Termageddon]</span>
        </p>
      </div>

      <!-- Termageddon Embed Placeholder -->
      <div id="termageddon-terms-container" class="prose prose-lg max-w-none">
        <!-- 
          ================================================================
          TERMAGEDDON EMBED INSTRUCTIONS:
          ================================================================
          
          Replace this entire comment block with your Termageddon embed script.
          
          The script should look something like:
          <script src="https://app.termageddon.com/embed/terms/[YOUR-UNIQUE-ID]"></script>
          
          OR it might be an iframe:
          <iframe src="https://app.termageddon.com/embed/terms/[YOUR-UNIQUE-ID]" 
                  width="100%" 
                  height="800" 
                  frameborder="0">
          </iframe>
          
          The Termageddon script will automatically:
          - Insert your Terms of Service content here
          - Keep the content updated as laws change
          - Handle all formatting and styling
          - Update the "Last Updated" date automatically
          
          ================================================================
        -->
        
        <!-- Temporary Placeholder Content -->
        <div class="bg-gray-100 border-2 border-dashed border-gray-400 rounded-lg p-8 text-center">
          <svg class="w-16 h-16 text-gray-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <h2 class="text-2xl font-semibold text-gray-700 mb-2">
            Termageddon Terms of Service
          </h2>
          <p class="text-gray-600 mb-4">
            This area will display your Terms of Service once you add the Termageddon embed code.
          </p>
          <div class="bg-white rounded p-4 text-left max-w-md mx-auto">
            <p class="text-sm text-gray-700 font-mono">
              &lt;!-- Add your Termageddon embed script here --&gt;
            </p>
          </div>
        </div>
      </div>

      <!-- Additional Information -->
      <div class="mt-12 pt-8 border-t border-gray-200">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Questions About These Terms?</h2>
        <p class="text-gray-700 mb-6">
          If you have any questions about these Terms of Service, please contact us:
        </p>
        <div class="bg-gray-50 rounded-lg p-6 space-y-3">
          <p class="text-gray-700">
            <strong>Email:</strong> 
            <a href={`mailto:${COMPANY.email.main}`} class="text-blue-600 hover:text-blue-800 transition-colors">
              {COMPANY.email.main}
            </a>
          </p>
          <p class="text-gray-700">
            <strong>Phone:</strong> 
            <a href={`tel:${COMPANY.phone.main.replace(/[^0-9]/g, '')}`} class="text-blue-600 hover:text-blue-800 transition-colors">
              {COMPANY.phone.main}
            </a>
          </p>
          <p class="text-gray-700">
            <strong>Address:</strong><br>
            {COMPANY.name}<br>
            {COMPANY.address.street}<br>
            {COMPANY.address.city}, {COMPANY.address.state} {COMPANY.address.zip}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">
        Ready to Start Your 1031 Exchange?
      </h2>
      <p class="text-gray-600 mb-8">
        Our expert team is here to guide you through every step of the process.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/start-exchange" 
          class="inline-block bg-yellow-400 text-blue-900 px-8 py-3 rounded-lg font-semibold hover:bg-yellow-300 transition-colors duration-200"
        >
          Start Your Exchange
        </a>
        <a 
          href="/schedule" 
          class="inline-block bg-blue-900 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-800 transition-colors duration-200"
        >
          Book Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Styles for Termageddon content if needed */
  #termageddon-terms-container {
    /* Add any custom styles for the embedded content here */
    min-height: 400px;
  }
  
  /* Ensure proper spacing for legal content */
  #termageddon-terms-container h1,
  #termageddon-terms-container h2,
  #termageddon-terms-container h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  #termageddon-terms-container p {
    margin-bottom: 1rem;
  }
  
  #termageddon-terms-container ul,
  #termageddon-terms-container ol {
    margin-bottom: 1rem;
    padding-left: 2rem;
  }
</style>
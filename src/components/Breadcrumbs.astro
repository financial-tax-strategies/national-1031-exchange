---
export interface BreadcrumbItem {
  name: string;
  url?: string;
}

export interface Props {
  items: BreadcrumbItem[];
  class?: string;
  theme?: 'light' | 'dark';
}

const { items = [], class: className = '', theme = 'light' } = Astro.props;

// Generate schema markup for breadcrumbs
const schemaItems = items.map((item, index) => ({
  "@type": "ListItem",
  "position": index + 1,
  "name": item.name,
  "item": item.url ? `https://the1031center.com${item.url}` : undefined
})).filter(item => item.item); // Only include items with URLs in schema

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": schemaItems
};
---

<!-- Breadcrumb Navigation -->
<nav aria-label="Breadcrumb" class={`text-sm ${className}`}>
  <ol class="flex items-center space-x-2">
    {items.map((item, index) => (
      <>
        {index > 0 && (
          <li class={theme === 'dark' ? 'text-white/60' : 'text-gray-400'}>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
          </li>
        )}
        <li>
          {item.url ? (
            <a 
              href={item.url} 
              class={theme === 'dark' 
                ? 'text-white/80 hover:text-white transition-colors' 
                : 'text-gray-600 hover:text-blue-900 transition-colors'}
              aria-current={index === items.length - 1 ? 'page' : undefined}
            >
              {item.name}
            </a>
          ) : (
            <span class={theme === 'dark' 
              ? 'text-white font-medium' 
              : 'text-gray-900 font-medium'} 
              aria-current="page">
              {item.name}
            </span>
          )}
        </li>
      </>
    ))}
  </ol>
</nav>

<!-- Breadcrumb Schema Markup -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>

<style>
  /* Ensure proper alignment on mobile */
  @media (max-width: 640px) {
    nav {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    
    ol {
      white-space: nowrap;
    }
  }
</style>
---
// Google Tag Manager Body (noscript fallback)
// This component must be placed immediately after the opening <body> tag
import { supabase, isSupabaseConfigured } from '../../lib/supabase';

let GTM_ID = import.meta.env.PUBLIC_GTM_ID;

// Fix for Netlify SSR - check multiple production indicators
// Netlify sets CONTEXT='production' for production deploys
const isNetlifyProduction = process.env.CONTEXT === 'production' || process.env.NETLIFY === 'true';
const isProduction = import.meta.env.PROD || 
                     import.meta.env.MODE === 'production' ||
                     process.env.NODE_ENV === 'production' ||
                     isNetlifyProduction;

// Try to load GTM ID from database configuration
console.log('[GTM-Body] Starting GTM Body configuration load...');
console.log('[GTM-Body] isSupabaseConfigured:', isSupabaseConfigured());
console.log('[GTM-Body] Initial GTM_ID from env:', GTM_ID);

if (isSupabaseConfigured()) {
  try {
    const { data, error } = await supabase
      .from('seo_config')
      .select('analytics')
      .eq('tenant_id', 'default')
      .single();
    
    console.log('[GTM-Body] Database query result:', { data, error });
    
    if (error) {
      console.error('[GTM-Body] Database query error:', error);
    } else if (data) {
      console.log('[GTM-Body] Database data.analytics:', data.analytics);
      if (data.analytics && data.analytics.gtm_id) {
        GTM_ID = data.analytics.gtm_id;
        console.log('[GTM-Body] Updated GTM_ID from database:', GTM_ID);
      } else {
        console.log('[GTM-Body] No gtm_id found in database analytics data');
      }
    } else {
      console.log('[GTM-Body] No data returned from database');
    }
  } catch (error) {
    console.error('[GTM-Body] Exception loading GTM configuration:', error);
  }
}

// Only use GTM if we have a valid ID
console.log('[GTM-Body] Final GTM_ID:', GTM_ID);
const hasValidGTM = GTM_ID && GTM_ID !== 'GTM-XXXXXXX' && GTM_ID !== '' && GTM_ID !== undefined;
console.log('[GTM-Body] hasValidGTM:', hasValidGTM);

// TEMPORARY FIX: Always load GTM if we have a valid ID
// Netlify SSR is not setting environment variables correctly
const shouldLoadGTM = hasValidGTM;
console.log('[GTM-Body] shouldLoadGTM:', shouldLoadGTM);
---

{shouldLoadGTM && (
  <!-- Google Tag Manager (noscript) -->
  <noscript>
    <iframe 
      src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
      height="0" 
      width="0" 
      style="display:none;visibility:hidden">
    </iframe>
  </noscript>
  <!-- End Google Tag Manager (noscript) -->
)}
---
// Google Tag Manager component
// This component loads the GTM ID from the database if available,
// falling back to environment variables if not configured
import { supabase, isSupabaseConfigured } from '../../lib/supabase';

// IMPORTANT: This component should only run server-side
// Client-side hydration can cause duplicate script loading

let GTM_ID = import.meta.env.PUBLIC_GTM_ID;

// Check multiple production indicators
const isVercelProduction = process.env.VERCEL_ENV === 'production' || process.env.VERCEL === '1';
const isProduction = import.meta.env.PROD ||
                     import.meta.env.MODE === 'production' ||
                     process.env.NODE_ENV === 'production' ||
                     isVercelProduction;

// Try to load GTM ID from database configuration
if (isSupabaseConfigured()) {
  try {
    const { data } = await supabase
      .from('seo_config')
      .select('analytics')
      .eq('tenant_id', 'default')
      .single();
    
    if (data && data.analytics && data.analytics.gtm_id) {
      GTM_ID = data.analytics.gtm_id;
    }
  } catch (error) {
    // Silently fall back to environment variable
    console.error('Failed to load GTM configuration from database:', error);
  }
}

// Only use GTM if we have a valid ID
const hasValidGTM = GTM_ID && GTM_ID !== 'GTM-XXXXXXX' && GTM_ID !== '' && GTM_ID !== undefined;

// Always load GTM if we have a valid ID (SSR mode)
const shouldLoadGTM = hasValidGTM;
---

{shouldLoadGTM && (
  <>
    <!-- Google Tag Manager - Initialize dataLayer first -->
    <script>
      // Initialize dataLayer immediately to ensure it exists
      window.dataLayer = window.dataLayer || [];
      
      // Add error handler to prevent SVG errors from blocking GTM
      window.addEventListener('error', function(e) {
        if (e.message && e.message.includes('Expected arc flag')) {
          console.warn('SVG path error caught and ignored:', e.message);
          e.preventDefault();
          return true;
        }
      }, true);
    </script>
    
    <!-- Google Tag Manager -->
    <script define:vars={{ GTM_ID }}>
      // Wrap GTM initialization in try-catch to ensure it runs even if there are page errors
      try {
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',GTM_ID);
        console.log('GTM initialized with ID:', GTM_ID);
      } catch (e) {
        console.error('GTM initialization error:', e);
      }
    </script>
    
    <!-- Data Layer Helper Functions -->
    <script>
      // Verify GTM loaded and retry if needed
      setTimeout(function() {
        if (!window.dataLayer || !window.google_tag_manager) {
          console.warn('GTM may not have loaded properly, checking...');
          // Check if GTM script exists
          var scripts = document.getElementsByTagName('script');
          var gtmFound = false;
          for (var i = 0; i < scripts.length; i++) {
            if (scripts[i].src && scripts[i].src.includes('googletagmanager.com/gtm.js')) {
              gtmFound = true;
              break;
            }
          }
          if (gtmFound) {
            console.log('GTM script found in DOM');
          } else {
            console.error('GTM script not found in DOM');
          }
        } else {
          console.log('GTM loaded successfully');
        }
      }, 2000);
      
      // Push custom events to GTM data layer
      window.pushDataLayer = function(eventData) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(eventData);
      };
      
      // Track HighLevel events
      window.trackHighLevelEvent = function(eventName, leadData) {
        window.pushDataLayer({
          'event': 'highlevel_' + eventName,
          'lead_source': leadData.source || 'website',
          'lead_value': leadData.value || 0,
          'lead_type': leadData.type || 'general',
          'form_name': leadData.formName || '',
          'calculator_savings': leadData.calculatorSavings || 0
        });
      };
      
      // Enhanced Ecommerce for lead value tracking
      window.trackLeadValue = function(leadSource, estimatedValue) {
        window.pushDataLayer({
          'event': 'lead_captured',
          'ecommerce': {
            'currency': 'USD',
            'value': estimatedValue,
            'items': [{
              'item_name': '1031 Exchange Lead',
              'item_category': leadSource,
              'price': estimatedValue,
              'quantity': 1
            }]
          }
        });
      };
      
      // Track calculator funnel
      window.trackCalculatorStep = function(step, data) {
        window.pushDataLayer({
          'event': 'calculator_funnel',
          'calculator_step': step,
          'calculator_data': data || {}
        });
      };
      
      // Track form interactions
      window.trackFormInteraction = function(action, formId, fieldName) {
        window.pushDataLayer({
          'event': 'form_interaction',
          'form_action': action,
          'form_id': formId,
          'field_name': fieldName || ''
        });
      };
    </script>
  </>
)}

<!-- Development mode scripts removed to prevent SSR hydration issues -->
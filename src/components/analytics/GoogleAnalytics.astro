---
// Google Analytics 4 component
// This component loads the GA4 measurement ID from the database if available,
// falling back to environment variables if not configured
import { supabase, isSupabaseConfigured } from '../../lib/supabase';

// IMPORTANT: This component should only run server-side
// Client-side hydration can cause duplicate script loading

let GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const isProduction = import.meta.env.PROD;

// Try to load GA4 ID from database configuration
if (isSupabaseConfigured()) {
  try {
    const { data } = await supabase
      .from('seo_config')
      .select('analytics')
      .eq('tenant_id', 'default')
      .single();
    
    if (data && data.analytics && data.analytics.ga4_id) {
      GA_MEASUREMENT_ID = data.analytics.ga4_id;
    }
  } catch (error) {
    // Silently fall back to environment variable
    console.error('Failed to load GA4 configuration from database:', error);
  }
}

// Only use GA if we have a valid measurement ID
const hasValidGA = GA_MEASUREMENT_ID && GA_MEASUREMENT_ID !== 'G-XXXXXXXXXX' && GA_MEASUREMENT_ID !== '' && GA_MEASUREMENT_ID !== undefined;

// Always load GA if we have a valid ID (SSR mode)
const shouldLoadGA = hasValidGA;
---

{shouldLoadGA && (
  <>
    <!-- Google Analytics 4 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      
      // Basic configuration
      gtag('config', GA_MEASUREMENT_ID, {
        page_path: window.location.pathname,
        cookie_flags: 'SameSite=None;Secure',
        anonymize_ip: true
      });
      
      // Enhanced measurement - automatically tracks:
      // - Page views
      // - Scrolls
      // - Outbound clicks
      // - Site search
      // - Video engagement
      // - File downloads
    </script>
    
    <!-- Custom event tracking functions -->
    <script>
      // Safe gtag wrapper that checks if gtag is defined
      function safeGtag() {
        if (typeof gtag !== 'undefined') {
          gtag.apply(null, arguments);
        } else {
          console.warn('Google Analytics not loaded yet, event not tracked:', arguments);
        }
      }
      
      // Calculator events
      window.trackCalculatorStart = function() {
        safeGtag('event', 'calculator_start', {
          event_category: 'engagement',
          event_label: '1031 Tax Calculator'
        });
      };
      
      window.trackCalculatorComplete = function(taxSavings) {
        safeGtag('event', 'calculator_complete', {
          event_category: 'conversion',
          event_label: '1031 Tax Calculator',
          value: Math.round(taxSavings),
          currency: 'USD'
        });
      };
      
      window.trackLeadCapture = function(source, value) {
        safeGtag('event', 'generate_lead', {
          event_category: 'conversion',
          event_label: source,
          value: value || 0,
          currency: 'USD'
        });
        
        // Also track for Google Ads if using
        safeGtag('event', 'conversion', {
          'send_to': 'AW-CONVERSION_ID/CONVERSION_LABEL',
          'value': value || 0,
          'currency': 'USD'
        });
      };
      
      // Form events
      window.trackFormStart = function(formName) {
        safeGtag('event', 'form_start', {
          event_category: 'engagement',
          event_label: formName
        });
      };
      
      window.trackFormSubmit = function(formName) {
        safeGtag('event', 'form_submit', {
          event_category: 'conversion',
          event_label: formName
        });
      };
      
      // Phone call tracking
      window.trackPhoneCall = function(source) {
        safeGtag('event', 'phone_call', {
          event_category: 'conversion',
          event_label: source || 'website'
        });
      };
      
      // Content engagement
      window.trackContentEngagement = function(contentType, contentName) {
        safeGtag('event', 'content_engagement', {
          event_category: 'engagement',
          content_type: contentType,
          content_name: contentName
        });
      };
      
      // Scroll depth tracking
      let scrollDepthTracked = {};
      window.addEventListener('scroll', function() {
        if (typeof gtag === 'undefined') return; // Don't track if gtag not loaded
        
        const scrollPercent = Math.round((window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100);
        const depths = [25, 50, 75, 90, 100];
        
        depths.forEach(depth => {
          if (scrollPercent >= depth && !scrollDepthTracked[depth]) {
            scrollDepthTracked[depth] = true;
            safeGtag('event', 'scroll', {
              event_category: 'engagement',
              event_label: `${depth}%`,
              value: depth
            });
          }
        });
      });
      
      // Time on page tracking (fires after 30 seconds)
      setTimeout(function() {
        safeGtag('event', 'time_on_page', {
          event_category: 'engagement',
          event_label: '30_seconds',
          value: 30
        });
      }, 30000);
    </script>
  </>
)}

<!-- Development mode scripts removed to prevent SSR hydration issues -->
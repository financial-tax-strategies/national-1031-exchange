---
// Google Analytics 4 component
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-XXXXXXXXXX';
const isProduction = import.meta.env.PROD;
---

{isProduction && (
  <>
    <!-- Google Analytics 4 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      
      // Basic configuration
      gtag('config', GA_MEASUREMENT_ID, {
        page_path: window.location.pathname,
        cookie_flags: 'SameSite=None;Secure',
        anonymize_ip: true
      });
      
      // Enhanced measurement - automatically tracks:
      // - Page views
      // - Scrolls
      // - Outbound clicks
      // - Site search
      // - Video engagement
      // - File downloads
    </script>
    
    <!-- Custom event tracking functions -->
    <script>
      // Calculator events
      window.trackCalculatorStart = function() {
        gtag('event', 'calculator_start', {
          event_category: 'engagement',
          event_label: '1031 Tax Calculator'
        });
      };
      
      window.trackCalculatorComplete = function(taxSavings) {
        gtag('event', 'calculator_complete', {
          event_category: 'conversion',
          event_label: '1031 Tax Calculator',
          value: Math.round(taxSavings),
          currency: 'USD'
        });
      };
      
      window.trackLeadCapture = function(source, value) {
        gtag('event', 'generate_lead', {
          event_category: 'conversion',
          event_label: source,
          value: value || 0,
          currency: 'USD'
        });
        
        // Also track for Google Ads if using
        gtag('event', 'conversion', {
          'send_to': 'AW-CONVERSION_ID/CONVERSION_LABEL',
          'value': value || 0,
          'currency': 'USD'
        });
      };
      
      // Form events
      window.trackFormStart = function(formName) {
        gtag('event', 'form_start', {
          event_category: 'engagement',
          event_label: formName
        });
      };
      
      window.trackFormSubmit = function(formName) {
        gtag('event', 'form_submit', {
          event_category: 'conversion',
          event_label: formName
        });
      };
      
      // Phone call tracking
      window.trackPhoneCall = function(source) {
        gtag('event', 'phone_call', {
          event_category: 'conversion',
          event_label: source || 'website'
        });
      };
      
      // Content engagement
      window.trackContentEngagement = function(contentType, contentName) {
        gtag('event', 'content_engagement', {
          event_category: 'engagement',
          content_type: contentType,
          content_name: contentName
        });
      };
      
      // Scroll depth tracking
      let scrollDepthTracked = {};
      window.addEventListener('scroll', function() {
        const scrollPercent = Math.round((window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100);
        const depths = [25, 50, 75, 90, 100];
        
        depths.forEach(depth => {
          if (scrollPercent >= depth && !scrollDepthTracked[depth]) {
            scrollDepthTracked[depth] = true;
            gtag('event', 'scroll', {
              event_category: 'engagement',
              event_label: `${depth}%`,
              value: depth
            });
          }
        });
      });
      
      // Time on page tracking (fires after 30 seconds)
      setTimeout(function() {
        gtag('event', 'time_on_page', {
          event_category: 'engagement',
          event_label: '30_seconds',
          value: 30
        });
      }, 30000);
    </script>
  </>
)}

{!isProduction && (
  <script>
    // Development mode - log events to console instead
    console.log('Google Analytics: Development mode - events will be logged to console');
    
    window.trackCalculatorStart = () => console.log('GA Event: calculator_start');
    window.trackCalculatorComplete = (savings) => console.log('GA Event: calculator_complete', { savings });
    window.trackLeadCapture = (source, value) => console.log('GA Event: generate_lead', { source, value });
    window.trackFormStart = (name) => console.log('GA Event: form_start', { name });
    window.trackFormSubmit = (name) => console.log('GA Event: form_submit', { name });
    window.trackPhoneCall = (source) => console.log('GA Event: phone_call', { source });
    window.trackContentEngagement = (type, name) => console.log('GA Event: content_engagement', { type, name });
  </script>
)}
---
// Redesigned Navigation component with improved UX and fewer top-level items
import { COMPANY } from '../config/company';
---

<nav class="bg-white shadow-lg sticky top-0 z-50" role="navigation" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="text-2xl font-bold text-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded-md px-2">
          {COMPANY.name}
        </a>
      </div>
      
      <!-- Desktop Navigation -->
      <div class="hidden lg:flex lg:items-center lg:space-x-6">
        <div class="flex items-baseline space-x-6">
          <!-- 1031 Services Mega Menu -->
          <div class="relative group">
            <button 
              class="nav-button text-gray-700 hover:text-blue-900 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200 flex items-center focus:outline-none focus:ring-2 focus:ring-blue-500"
              aria-expanded="false"
              aria-haspopup="true"
            >
              1031 Services
              <svg class="ml-1 h-4 w-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            
            <!-- Mega Menu Content -->
            <div class="mega-menu absolute left-0 mt-2 bg-white rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-[800px]">
              <div class="rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 overflow-hidden">
                <div class="grid grid-cols-3 gap-6 p-8">
                  <!-- Service Types Column -->
                  <div>
                    <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Exchange Types</h3>
                    <div class="space-y-3">
                      <a href="/services/delayed-exchange" class="group/link flex items-start">
                        <span class="flex-shrink-0 w-6 h-6 bg-blue-100 rounded-md flex items-center justify-center mr-3 group-hover/link:bg-blue-200 transition-colors">
                          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                        </span>
                        <div>
                          <p class="text-sm font-medium text-gray-900 group-hover/link:text-blue-900">Delayed Exchange</p>
                          <p class="text-xs text-gray-500 mt-1">Most common - 45/180 day timeline</p>
                        </div>
                      </a>
                      <a href="/services/reverse-exchange" class="group/link flex items-start">
                        <span class="flex-shrink-0 w-6 h-6 bg-blue-100 rounded-md flex items-center justify-center mr-3 group-hover/link:bg-blue-200 transition-colors">
                          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                          </svg>
                        </span>
                        <div>
                          <p class="text-sm font-medium text-gray-900 group-hover/link:text-blue-900">Reverse Exchange</p>
                          <p class="text-xs text-gray-500 mt-1">Buy first, then sell</p>
                        </div>
                      </a>
                      <a href="/services/improvement-exchange" class="group/link flex items-start">
                        <span class="flex-shrink-0 w-6 h-6 bg-blue-100 rounded-md flex items-center justify-center mr-3 group-hover/link:bg-blue-200 transition-colors">
                          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                          </svg>
                        </span>
                        <div>
                          <p class="text-sm font-medium text-gray-900 group-hover/link:text-blue-900">Improvement Exchange</p>
                          <p class="text-xs text-gray-500 mt-1">Add value during exchange</p>

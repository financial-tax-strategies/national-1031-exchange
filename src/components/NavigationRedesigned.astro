                      </a>
                      <a href="/services/partial-exchange" class="group/link flex items-start">
                        <span class="flex-shrink-0 w-6 h-6 bg-blue-100 rounded-md flex items-center justify-center mr-3 group-hover/link:bg-blue-200 transition-colors">
                          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                        </span>
                        <div>
                          <p class="text-sm font-medium text-gray-900 group-hover/link:text-blue-900">Partial Exchange</p>
                          <p class="text-xs text-gray-500 mt-1">Exchange with cash out</p>
                        </div>
                      </a>
                    </div>
                  </div>
                  
                  <!-- Getting Started Column -->
                  <div>
                    <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Getting Started</h3>
                    <div class="space-y-3">
                      <a href="/how-it-works" class="group/link flex items-start">
                        <span class="flex-shrink-0 w-6 h-6 bg-green-100 rounded-md flex items-center justify-center mr-3 group-hover/link:bg-green-200 transition-colors">
                          <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                          </svg>
                        </span>
                        <div>
                          <p class="text-sm font-medium text-gray-900 group-hover/link:text-blue-900">How It Works</p>
                          <p class="text-xs text-gray-500 mt-1">Step-by-step process guide</p>
                        </div>
                      </a>
                      <a href="/1031-exchange-timeline" class="group/link flex items-start">
                        <span class="flex-shrink-0 w-6 h-6 bg-green-100 rounded-md flex items-center justify-center mr-3 group-hover/link:bg-green-200 transition-colors">
                          <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                          </svg>
                        </span>
                        <div>
                          <p class="text-sm font-medium text-gray-900 group-hover/link:text-blue-900">Timeline & Deadlines</p>
                          <p class="text-xs text-gray-500 mt-1">Critical dates calculator</p>
                        </div>
                      </a>
                      
                      <!-- CTA within menu -->
                      <div class="pt-4">
                        <a href="/start-exchange" class="block w-full bg-yellow-400 text-blue-900 px-4 py-2 rounded-md text-sm font-medium hover:bg-yellow-300 transition-colors text-center">
                          Start Your Exchange →
                        </a>
                      </div>
                    </div>
                  </div>
                  
                  <!-- Featured Content Column -->
                  <div class="bg-gray-50 -m-8 ml-0 p-8 rounded-r-lg">
                    <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Featured</h3>
                    <div class="bg-white rounded-lg p-4 shadow-sm">
                      <p class="text-xs font-semibold text-blue-600 uppercase tracking-wider">New to 1031?</p>
                      <p class="mt-2 text-sm text-gray-900 font-medium">Complete Guide to 1031 Exchanges</p>
                      <p class="mt-1 text-xs text-gray-500">Everything you need to know about tax-deferred exchanges</p>
                      <a href="/complete-guide-1031-exchanges" class="mt-3 text-xs font-medium text-blue-600 hover:text-blue-500 inline-flex items-center">
                        Read the guide
                        <svg class="ml-1 w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                      </a>
                    </div>
                    
                    <div class="mt-6">
                      <p class="text-xs text-gray-500 mb-2">Quick Stats:</p>
                      <div class="space-y-1">
                        <div class="flex items-center text-xs">
                          <span class="text-green-500 mr-1">✓</span>
                          <span class="text-gray-600">$2B+ in exchanges</span>
                        </div>
                        <div class="flex items-center text-xs">
                          <span class="text-green-500 mr-1">✓</span>
                          <span class="text-gray-600">50 states covered</span>
                        </div>
                        <div class="flex items-center text-xs">
                          <span class="text-green-500 mr-1">✓</span>
                          <span class="text-gray-600">20+ years experience</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Resources & Tools Mega Menu -->
          <div class="relative group">
            <button 
              class="nav-button text-gray-700 hover:text-blue-900 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200 flex items-center focus:outline-none focus:ring-2 focus:ring-blue-500"
              aria-expanded="false"
              aria-haspopup="true"
            >
              Resources & Tools
              <svg class="ml-1 h-4 w-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            
            <!-- Mega Menu Content -->
            <div class="mega-menu absolute left-0 mt-2 bg-white rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-[900px]">
              <div class="rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 overflow-hidden">
                <div class="grid grid-cols-4 gap-6 p-8">
                  <!-- Learning Center Column -->
                  <div>
                    <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Learning Center</h3>
                    <div class="space-y-2">
                      <a href="/complete-guide-1031-exchanges" class="block text-sm text-gray-600 hover:text-blue-900 hover:bg-blue-50 px-2 py-1 rounded transition-colors">
                        Complete Guide
                      </a>
                      <a href="/1031-exchange-rules" class="block text-sm text-gray-600 hover:text-blue-900 hover:bg-blue-50 px-2 py-1 rounded transition-colors">
                        Exchange Rules
                      </a>
                      <a href="/types-of-1031-exchanges" class="block text-sm text-gray-600 hover:text-blue-900 hover:bg-blue-50 px-2 py-1 rounded transition-colors">
                        Types of Exchanges
                      </a>
                      <a href="/choosing-qualified-intermediary" class="block text-sm text-gray-600 hover:text-blue-900 hover:bg-blue-50 px-2 py-1 rounded transition-colors">
                        Choosing a QI
                      </a>
                      <a href="/faq" class="block text-sm text-gray-600 hover:text-blue-900 hover:bg-blue-50 px-2 py-1 rounded transition-colors">
                        FAQ
                      </a>
                    </div>
                  </div>
                  
                  <!-- Interactive Tools Column -->
                  <div>
                    <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Interactive Tools</h3>
                    <div class="space-y-2">
                      <a href="/calculator" class="group/tool block">
                        <div class="bg-blue-50 rounded-lg p-3 hover:bg-blue-100 transition-colors">
                          <p class="text-sm font-medium text-gray-900">Tax Savings Calculator</p>
                          <p class="text-xs text-gray-600 mt-1">Estimate your savings</p>
                        </div>
                      </a>
                      <a href="/timeline-calculator" class="group/tool block">
                        <div class="bg-green-50 rounded-lg p-3 hover:bg-green-100 transition-colors">
                          <p class="text-sm font-medium text-gray-900">Timeline Calculator</p>
                          <p class="text-xs text-gray-600 mt-1">Track your deadlines</p>
                        </div>
                      </a>
                    </div>
                  </div>
                  
                  <!-- Browse By Column -->
                  <div>
                    <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Browse By</h3>
                    <div class="space-y-3">
                      <a href="/property-types" class="group/browse block">
                        <div class="flex items-center justify-between">
                          <span class="text-sm text-gray-600 group-hover/browse:text-blue-900">Property Types</span>
                          <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">20 types</span>
                        </div>
                      </a>
                      <a href="/scenarios" class="group/browse block">
                        <div class="flex items-center justify-between">
                          <span class="text-sm text-gray-600 group-hover/browse:text-blue-900">Common Scenarios</span>
                          <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">30 scenarios</span>
                        </div>
                      </a>
                    </div>
                  </div>
                  
                  <!-- Quick Actions Column -->
                  <div class="bg-gray-50 -m-8 ml-0 p-8 rounded-r-lg">
                    <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Quick Actions</h3>
                    <div class="space-y-2">
                      <a href="/schedule" class="block w-full bg-blue-900 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-800 transition-colors text-center">
                        Schedule Consultation
                      </a>
                      <a href="/start-exchange" class="block w-full bg-yellow-400 text-blue-900 px-4 py-2 rounded-md text-sm font-medium hover:bg-yellow-300 transition-colors text-center">
                        Start Exchange
                      </a>
                    </div>
                    
                    <div class="mt-6 pt-6 border-t border-gray-200">
                      <p class="text-xs font-semibold text-gray-900 mb-2">Popular Resources</p>
                      <div class="space-y-1">
                        <a href="/1031-exchange-timeline" class="text-xs text-blue-600 hover:text-blue-500 block">→ 45/180 Day Timeline</a>
                        <a href="/calculator" class="text-xs text-blue-600 hover:text-blue-500 block">→ Calculate Your Savings</a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Locations (Simple Dropdown) -->
          <div class="relative group">
            <button 
              class="nav-button text-gray-700 hover:text-blue-900 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200 flex items-center focus:outline-none focus:ring-2 focus:ring-blue-500"
              aria-expanded="false"
              aria-haspopup="true"
            >
              Locations
              <svg class="ml-1 h-4 w-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            
            <div class="absolute left-0 mt-2 w-80 bg-white rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              <div class="py-4 px-6">
                <h3 class="text-sm font-semibold text-gray-900 mb-3">Service Areas</h3>
                <p class="text-xs text-gray-500 mb-3">We serve all 50 states</p>
                <div class="grid grid-cols-2 gap-2 mb-4">
                  <a href="/locations/california" class="text-sm text-gray-600 hover:text-blue-900 transition-colors">California</a>
                  <a href="/locations/texas" class="text-sm text-gray-600 hover:text-blue-900 transition-colors">Texas</a>
                  <a href="/locations/florida" class="text-sm text-gray-600 hover:text-blue-900 transition-colors">Florida</a>
                  <a href="/locations/new-york" class="text-sm text-gray-600 hover:text-blue-900 transition-colors">New York</a>
                  <a href="/locations/illinois" class="text-sm text-gray-600 hover:text-blue-900 transition-colors">Illinois</a>
                  <a href="/locations/arizona" class="text-sm text-gray-600 hover:text-blue-900 transition-colors">Arizona</a>
                </div>
                <div class="pt-3 border-t border-gray-200">
                  <a href="/locations" class="text-sm text-blue-900 hover:text-blue-700 font-medium inline-flex items-center">
                    View All 50 States
                    <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
          
          <!-- About (Simple Dropdown) -->
          <div class="relative group">
            <button 
              class="nav-button text-gray-700 hover:text-blue-900 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200 flex items-center focus:outline-none focus:ring-2 focus:ring-blue-500"

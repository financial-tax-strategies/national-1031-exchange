        </a>
        <a href="/contact" class="block px-3 py-2 text-base font-medium text-gray-700 hover:text-blue-900 hover:bg-blue-50 rounded-md">
          Contact
        </a>
        
        <!-- Mobile CTAs -->
        <div class="pt-4 space-y-2">
          <a href="/start-exchange" class="block px-3 py-2 text-base font-medium bg-yellow-400 text-blue-900 hover:bg-yellow-300 rounded-md text-center">
            Start Your Exchange
          </a>
          <a href="/schedule" class="block px-3 py-2 text-base font-medium bg-blue-900 text-white hover:bg-blue-800 rounded-md text-center">
            Free Consultation
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  /* Enhanced keyboard navigation styles */
  .nav-button:focus-visible,
  a:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 2px;
  }
  
  /* Improved mega menu animations */
  .mega-menu {
    transform: translateY(-10px);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .group:hover .mega-menu {
    transform: translateY(0);
  }
  
  /* Mobile accordion animation */
  .mobile-section-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }
  
  .mobile-section-content.show {
    max-height: 500px;
  }
  
  /* Prevent layout shift */
  nav {
    min-height: 64px;
  }
  
  /* Improved focus states for accessibility */
  button[aria-expanded="true"] {
    color: #1e40af;
    background-color: #eff6ff;
  }
  
  /* Better hover states for touch devices */
  @media (hover: none) {
    .group:hover .mega-menu {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>

<script>
  // Enhanced mobile menu toggle with accessibility
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.querySelector('.mobile-menu-button');
    const mobileMenu = document.querySelector('.mobile-menu');
    const mobileSectionButtons = document.querySelectorAll('.mobile-section-button');
    const navButtons = document.querySelectorAll('.nav-button');
    
    // Mobile menu toggle
    mobileMenuButton?.addEventListener('click', function() {
      const isOpen = !mobileMenu?.classList.contains('hidden');
      mobileMenu?.classList.toggle('hidden');
      this.setAttribute('aria-expanded', (!isOpen).toString());
      this.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    });
    
    // Mobile accordion sections
    mobileSectionButtons.forEach(button => {
      button.addEventListener('click', function() {
        const content = this.nextElementSibling;
        const arrow = this.querySelector('svg');
        const isOpen = !content?.classList.contains('hidden');
        
        // Close all other sections
        mobileSectionButtons.forEach(otherButton => {
          if (otherButton !== button) {
            otherButton.nextElementSibling?.classList.add('hidden');
            otherButton.querySelector('svg')?.classList.remove('rotate-180');
          }
        });
        
        // Toggle current section
        content?.classList.toggle('hidden');
        content?.classList.toggle('show');
        arrow?.classList.toggle('rotate-180');
      });
    });
    
    // Desktop dropdown keyboard navigation
    navButtons.forEach(button => {
      const dropdown = button.parentElement?.querySelector('.mega-menu, .absolute');
      
      // Mouse events
      button.addEventListener('mouseenter', () => {
        button.setAttribute('aria-expanded', 'true');
      });
      
      button.parentElement?.addEventListener('mouseleave', () => {
        button.setAttribute('aria-expanded', 'false');
      });
      
      // Keyboard events
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const isOpen = this.getAttribute('aria-expanded') === 'true';
        
        // Close all other dropdowns
        navButtons.forEach(otherButton => {
          if (otherButton !== button) {
            otherButton.setAttribute('aria-expanded', 'false');
          }
        });
        
        // Toggle current dropdown
        this.setAttribute('aria-expanded', (!isOpen).toString());
        
        if (!isOpen && dropdown) {
          dropdown.classList.remove('opacity-0', 'invisible');
          dropdown.classList.add('opacity-100', 'visible');
        } else if (dropdown) {
          dropdown.classList.add('opacity-0', 'invisible');
          dropdown.classList.remove('opacity-100', 'visible');
        }
      });
      
      // Close on Escape
      button.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && this.getAttribute('aria-expanded') === 'true') {
          this.setAttribute('aria-expanded', 'false');
          dropdown?.classList.add('opacity-0', 'invisible');
          dropdown?.classList.remove('opacity-100', 'visible');
        }
      });
    });
    
    // Close dropdowns when clicking outside
    document.addEventListener('click', function(e) {
      if (!e.target.closest('nav')) {
        navButtons.forEach(button => {
          button.setAttribute('aria-expanded', 'false');
          const dropdown = button.parentElement?.querySelector('.mega-menu, .absolute');
          dropdown?.classList.add('opacity-0', 'invisible');
          dropdown?.classList.remove('opacity-100', 'visible');
        });
      }
    });
  });
</script>
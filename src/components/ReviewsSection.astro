---
export interface Props {
  limit?: number;
  showSummary?: boolean;
  featured?: boolean;
  className?: string;
}

const { 
  limit = 3, 
  showSummary = true, 
  featured = true,
  className = ''
} = Astro.props;

// Fetch reviews
const baseUrl = Astro.url.origin;
const reviewsUrl = new URL('/api/reviews', baseUrl);
reviewsUrl.searchParams.set('limit', limit.toString());
reviewsUrl.searchParams.set('featured', featured.toString());
reviewsUrl.searchParams.set('include_stats', showSummary.toString());

let reviews = [];
let summary = null;
let error = null;

try {
  const response = await fetch(reviewsUrl.toString());
  if (response.ok) {
    const data = await response.json();
    reviews = data.data || [];
    summary = data.summary;
  } else {
    error = 'Failed to load reviews';
  }
} catch (e) {
  error = 'Failed to load reviews';
  console.error('Error fetching reviews:', e);
}

// Fallback data if API fails
if (error && reviews.length === 0) {
  reviews = [
    {
      id: '1',
      author_name: 'John Smith',
      author_location: 'Los Angeles, CA',
      review_rating_value: 5,
      headline: 'Exceptional 1031 Exchange Service',
      review_body: 'The team at The 1031 Center made our exchange seamless. They handled all the complex paperwork and timing requirements perfectly. Highly recommend!',
      date_published: new Date().toISOString()
    }
  ];
}
---

<section class={`py-16 bg-gray-50 ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        What Our Clients Say
      </h2>
      {showSummary && summary && (
        <div class="flex justify-center items-center gap-4 text-lg">
          <div class="flex text-yellow-400">
            {[...Array(5)].map((_, i) => (
              <svg
                class={`h-6 w-6 ${i < Math.round(summary.average_rating) ? 'fill-current' : 'fill-gray-300'}`}
                viewBox="0 0 20 20"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <span class="text-gray-600">
            {summary.average_rating.toFixed(1)} out of 5 based on {summary.total_reviews} reviews
          </span>
        </div>
      )}
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {reviews.map(review => (
        <div class="bg-white rounded-lg shadow-lg p-6">
          <div class="flex items-center mb-4">
            <div class="flex text-yellow-400">
              {[...Array(5)].map((_, i) => (
                <svg
                  class={`h-5 w-5 ${i < review.review_rating_value ? 'fill-current' : 'fill-gray-300'}`}
                  viewBox="0 0 20 20"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
          </div>
          
          {review.headline && (
            <h3 class="font-semibold text-lg text-gray-900 mb-2">
              {review.headline}
            </h3>
          )}
          
          <p class="text-gray-700 mb-4">
            "{review.review_body}"
          </p>
          
          <div class="text-sm text-gray-600">
            <div class="font-medium">{review.author_name}</div>
            {review.author_location && (
              <div>{review.author_location}</div>
            )}
            <div class="text-xs mt-1">
              {new Date(review.date_published).toLocaleDateString()}
            </div>
          </div>
          
          {review.response_text && (
            <div class="mt-4 pt-4 border-t border-gray-200">
              <div class="text-sm font-medium text-gray-700 mb-1">
                Response from The 1031 Center:
              </div>
              <p class="text-sm text-gray-600 italic">
                {review.response_text}
              </p>
            </div>
          )}
        </div>
      ))}
    </div>
    
    <div class="text-center mt-12">
      <a 
        href="/testimonials" 
        class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium"
      >
        View All Reviews
        <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- Review Schema Markup -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AggregateRating",
  "itemReviewed": {
    "@type": "Service",
    "name": "1031 Exchange Services",
    "provider": {
      "@type": "Organization",
      "name": "The 1031 Center"
    }
  },
  "ratingValue": ${summary?.average_rating || 5},
  "bestRating": "5",
  "worstRating": "1",
  "ratingCount": ${summary?.total_reviews || reviews.length}
}
</script>

{reviews.map(review => (
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Review",
    "itemReviewed": {
      "@type": "Service",
      "name": "1031 Exchange Services"
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": ${review.review_rating_value},
      "bestRating": "5",
      "worstRating": "1"
    },
    "author": {
      "@type": "Person",
      "name": "${review.author_name}"${review.author_location ? `,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "${review.author_location}"
      }` : ''}
    },
    "datePublished": "${review.date_published}",
    "headline": "${review.headline || ''}",
    "reviewBody": "${review.review_body?.replace(/"/g, '\\"') || ''}"
  }
  </script>
))}
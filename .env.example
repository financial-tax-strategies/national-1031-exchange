# HighLevel (GoHighLevel) API Configuration
HIGHLEVEL_API_KEY=your-highlevel-api-key-here
HIGHLEVEL_LOCATION_ID=your-highlevel-location-id-here

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Netlify Environment (optional)
NETLIFY_SITE_ID=your-netlify-site-id
NETLIFY_AUTH_TOKEN=your-netlify-auth-token

# Site Configuration
SITE_URL=https://national1031center.com

# Email Configuration (if using SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# Development Mode
NODE_ENV=development
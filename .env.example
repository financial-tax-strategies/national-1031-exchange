# HighLevel (GoHighLevel) API Configuration
# Note: Vite requires VITE_ prefix for client-side environment variables
VITE_HIGHLEVEL_API_KEY=your-highlevel-api-key-here
VITE_HIGHLEVEL_LOCATION_ID=your-highlevel-location-id-here
VITE_HIGHLEVEL_CALENDAR_ID=your-highlevel-calendar-id-here

# Supabase Configuration
# Note: Astro uses PUBLIC_ prefix for client-side environment variables
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Webhook Security (server-side only)
HIGHLEVEL_WEBHOOK_SECRET=your-webhook-secret-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Netlify Environment (optional)
NETLIFY_SITE_ID=your-netlify-site-id
NETLIFY_AUTH_TOKEN=your-netlify-auth-token

# Site Configuration
SITE_URL=https://national1031center.com

# Email Configuration (if using SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# Development Mode
NODE_ENV=development
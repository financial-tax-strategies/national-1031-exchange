  "faqSchema": {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a 1031 exchange?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A 1031 exchange, also known as a like-kind exchange, is a tax strategy that allows real estate investors to defer paying capital gains taxes when they sell an investment property and reinvest the proceeds into a similar property."
        }
      },
      {
        "@type": "Question",
        "name": "How long do I have to complete a 1031 exchange?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You have 45 days from the sale of your relinquished property to identify potential replacement properties, and 180 days (or until your tax return due date, whichever is earlier) to complete the purchase of the replacement property."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need a qualified intermediary for a 1031 exchange?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, using a qualified intermediary is required for a 1031 exchange. The intermediary holds the proceeds from the sale of your relinquished property and uses them to purchase the replacement property, ensuring you don't have constructive receipt of the funds."
        }
      }
    ]
  },
  
